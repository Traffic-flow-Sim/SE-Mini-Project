From 2e0750675c1e1e73323a1ad195f1870a7dfade55 Mon Sep 17 00:00:00 2001
From: Neal <nealpunjabi196@gmail.com>
Date: Thu, 29 Oct 2026 09:00:56 +0000
Subject: [PATCH 5/5] S1TMS-8 S1TMS-9: CI smoke tests assert the summary and
 bad-input handling

- the app run must print the summary with a passing integrity check
- letters, zero, negative, above-max, overflowing and 200-character input must
  be rejected with the right message and then recover on valid input
- input that ends early must exit non-zero instead of hanging

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_015D1Ltje8dSmxKDaSCetk2G
---
 .github/workflows/ci.yml | 24 +++++++++++++++++++++++-
 1 file changed, 23 insertions(+), 1 deletion(-)

diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
index 0a2acec..6cfa008 100644
--- a/.github/workflows/ci.yml
+++ b/.github/workflows/ci.yml
@@ -40,7 +40,29 @@ jobs:
         run: gcc $CFLAGS traffic_simulation.c queue.c -o traffic_simulation
 
       - name: Run application smoke test
-        run: printf '1\n1\n' | ./traffic_management
+        run: |
+          printf '1\n1\n' | ./traffic_management > run.log
+          tail -n 12 run.log
+          grep -q "Integrity check       : OK" run.log
+          grep -q "Maximum queue length" run.log
+
+      - name: Application rejects bad configuration input
+        run: |
+          # letters, zero, negative, above the maximum, overflow, then a valid 2 and 1
+          printf 'abc\n0\n-5\n101\n99999999999999999999\n2\n1\n' | ./traffic_management > bad_input.log
+          grep -q "Error: Enter a valid whole number." bad_input.log
+          grep -q "Error: Enter a value between 1 and 100." bad_input.log
+          grep -q "Traffic density: 2 vehicles per direction" bad_input.log
+          grep -q "Integrity check       : OK" bad_input.log
+          # a 200-character line must be rejected, not split into later answers
+          printf '%0200d\n2\n1\n' 5 | ./traffic_management > long_input.log
+          grep -q "Error: Input is too long." long_input.log
+          grep -q "Traffic density: 2 vehicles per direction" long_input.log
+          # input that ends early must fail cleanly instead of hanging
+          if printf '1\n' | ./traffic_management > /dev/null 2>&1; then
+            echo "expected a failure when the input ends early"
+            exit 1
+          fi
 
       - name: Run basic simulation smoke test
         run: ./traffic_simulation
