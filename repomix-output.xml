<file path="tests/test_queue.c">
#include <assert.h>
#include <stdio.h>

#include "../queue.h"

static Vehicle make_vehicle(unsigned int id)
{
    Vehicle vehicle = {id, id * 10};
    return vehicle;
}

static void test_empty_queue(void)
{
    VehicleQueue queue;
    Vehicle result;

    queue_init(&queue);

    assert(queue_is_empty(&queue));
    assert(!dequeue(&queue, &result));
    assert(queue.size == 0);
}

static void test_fifo_order(void)
{
    VehicleQueue queue;
    Vehicle result;

    queue_init(&queue);

    assert(enqueue(&queue, make_vehicle(1)));
    assert(enqueue(&queue, make_vehicle(2)));
    assert(enqueue(&queue, make_vehicle(3)));

    assert(dequeue(&queue, &result));
    assert(result.id == 1);

    assert(dequeue(&queue, &result));
    assert(result.id == 2);

    assert(dequeue(&queue, &result));
    assert(result.id == 3);

    assert(queue_is_empty(&queue));
}

static void test_full_queue(void)
{
    VehicleQueue queue;
    Vehicle result;
    unsigned int i;

    queue_init(&queue);

    for (i = 1; i <= QUEUE_CAPACITY; i++) {
        assert(enqueue(&queue, make_vehicle(i)));
    }

    assert(queue_is_full(&queue));
    assert(!enqueue(&queue, make_vehicle(QUEUE_CAPACITY + 1)));
    assert(queue.size == QUEUE_CAPACITY);

    for (i = 1; i <= QUEUE_CAPACITY; i++) {
        assert(dequeue(&queue, &result));
        assert(result.id == i);
    }

    assert(queue_is_empty(&queue));
}

static void test_circular_wraparound(void)
{
    VehicleQueue queue;
    Vehicle result;
    unsigned int i;

    queue_init(&queue);

    for (i = 1; i <= QUEUE_CAPACITY; i++) {
        assert(enqueue(&queue, make_vehicle(i)));
    }

    for (i = 1; i <= 4; i++) {
        assert(dequeue(&queue, &result));
        assert(result.id == i);
    }

    for (i = QUEUE_CAPACITY + 1; i <= QUEUE_CAPACITY + 4; i++) {
        assert(enqueue(&queue, make_vehicle(i)));
    }

    for (i = 5; i <= QUEUE_CAPACITY; i++) {
        assert(dequeue(&queue, &result));
        assert(result.id == i);
    }

    for (i = QUEUE_CAPACITY + 1; i <= QUEUE_CAPACITY + 4; i++) {
        assert(dequeue(&queue, &result));
        assert(result.id == i);
    }

    assert(queue_is_empty(&queue));
}


int main(void)
{
    test_empty_queue();
    test_fifo_order();
    test_full_queue();
    test_circular_wraparound();

    printf("All queue tests passed.\n");
    return 0;
}
</file>

<file path="tests/test_signal_audit.c">
/*
 * Tests for S1TMS-15: Traffic signal change logging and audit trail.
 */
#include <stdio.h>

#include "simulation.h"
#include "test_util.h"

static SimConfig audit_test_config(void)
{
    SimConfig config;

    sim_config_default(&config);

    config.num_directions = 2;
    config.initial_vehicles = 0;
    config.queue_capacity = QUEUE_CAPACITY;
    sim_config_set_traffic_density(&config, 0);
    config.green_ticks = 2;
    config.yellow_ticks = 1;
    config.discharge_per_tick = 1;
    config.total_ticks = 6;

    return config;
}

static void test_exact_signal_transitions_are_recorded(void)
{
    SimConfig config = audit_test_config();
    SimStats stats;
    SimSession session = {0};
    const SimSignalAuditEntry *entry;
    int i;

    CHECK(sim_session_start(&session, &config, &stats, NULL, NULL) == 1);

    for (i = 0; i < config.total_ticks; i++) {
        CHECK(sim_session_step(&session) == 1);
    }

    CHECK(session.state == SIM_SESSION_COMPLETED);
    CHECK(sim_session_audit_count(&session) == 5);

    /* Tick 0: Direction 0 changes from RED to GREEN. */
    entry = sim_session_audit_get(&session, 0);
    CHECK(entry != NULL);
    if (entry != NULL) {
        CHECK(entry->tick == 0);
        CHECK(entry->direction == 0);
        CHECK(entry->previous_signal == SIM_SIGNAL_RED);
        CHECK(entry->new_signal == SIM_SIGNAL_GREEN);
    }

    /* Tick 2: Direction 0 changes from GREEN to YELLOW. */
    entry = sim_session_audit_get(&session, 1);
    CHECK(entry != NULL);
    if (entry != NULL) {
        CHECK(entry->tick == 2);
        CHECK(entry->direction == 0);
        CHECK(entry->previous_signal == SIM_SIGNAL_GREEN);
        CHECK(entry->new_signal == SIM_SIGNAL_YELLOW);
    }

    /* Tick 3: Direction 0 changes to RED. */
    entry = sim_session_audit_get(&session, 2);
    CHECK(entry != NULL);
    if (entry != NULL) {
        CHECK(entry->tick == 3);
        CHECK(entry->direction == 0);
        CHECK(entry->previous_signal == SIM_SIGNAL_YELLOW);
        CHECK(entry->new_signal == SIM_SIGNAL_RED);
    }

    /* Tick 3: Direction 1 changes from RED to GREEN. */
    entry = sim_session_audit_get(&session, 3);
    CHECK(entry != NULL);
    if (entry != NULL) {
        CHECK(entry->tick == 3);
        CHECK(entry->direction == 1);
        CHECK(entry->previous_signal == SIM_SIGNAL_RED);
        CHECK(entry->new_signal == SIM_SIGNAL_GREEN);
    }

    /* Tick 5: Direction 1 changes from GREEN to YELLOW. */
    entry = sim_session_audit_get(&session, 4);
    CHECK(entry != NULL);
    if (entry != NULL) {
        CHECK(entry->tick == 5);
        CHECK(entry->direction == 1);
        CHECK(entry->previous_signal == SIM_SIGNAL_GREEN);
        CHECK(entry->new_signal == SIM_SIGNAL_YELLOW);
    }
}

static void test_audit_entries_are_chronological(void)
{
    SimConfig config = audit_test_config();
    SimStats stats;
    SimSession session = {0};
    const SimSignalAuditEntry *previous;
    const SimSignalAuditEntry *current;
    size_t i;

    CHECK(sim_session_start(&session, &config, &stats, NULL, NULL) == 1);

    while (session.state == SIM_SESSION_RUNNING) {
        CHECK(sim_session_step(&session) == 1);
    }

    for (i = 1; i < sim_session_audit_count(&session); i++) {
        previous = sim_session_audit_get(&session, i - 1);
        current = sim_session_audit_get(&session, i);

        CHECK(previous != NULL);
        CHECK(current != NULL);

        if (previous != NULL && current != NULL) {
            CHECK(previous->tick <= current->tick);
        }
    }
}

static void test_invalid_audit_requests(void)
{
    SimConfig config = audit_test_config();
    SimStats stats;
    SimSession session = {0};

    CHECK(sim_session_audit_count(NULL) == 0);
    CHECK(sim_session_audit_get(NULL, 0) == NULL);

    CHECK(sim_session_start(&session, &config, &stats, NULL, NULL) == 1);
    CHECK(sim_session_audit_count(&session) == 0);
    CHECK(sim_session_audit_get(&session, 0) == NULL);

    CHECK(sim_session_step(&session) == 1);
    CHECK(sim_session_audit_count(&session) == 1);
    CHECK(sim_session_audit_get(&session, 1) == NULL);
}

static void test_audit_history_resets_when_session_restarts(void)
{
    SimConfig config = audit_test_config();
    SimStats stats;
    SimSession session = {0};

    CHECK(sim_session_start(&session, &config, &stats, NULL, NULL) == 1);
    CHECK(sim_session_step(&session) == 1);
    CHECK(sim_session_audit_count(&session) == 1);

    CHECK(sim_session_stop(&session) == 1);
    CHECK(sim_session_start(&session, &config, &stats, NULL, NULL) == 1);

    CHECK(sim_session_audit_count(&session) == 0);
    CHECK(sim_session_step(&session) == 1);
    CHECK(sim_session_audit_count(&session) == 1);
}

int main(void)
{
    TEST_RUN(test_exact_signal_transitions_are_recorded);
    TEST_RUN(test_audit_entries_are_chronological);
    TEST_RUN(test_invalid_audit_requests);
    TEST_RUN(test_audit_history_resets_when_session_restarts);

    return TEST_SUMMARY();
}
</file>

<file path="tests/test_simulation_controls.c">
#include "simulation.h"
#include "test_util.h"

#include <string.h>

typedef struct {
    unsigned int ticks[8];
    int count;
} TickLog;

static void record_tick(const SimTickInfo *info, void *user)
{
    TickLog *log = (TickLog *)user;
    if (log->count < 8) log->ticks[log->count++] = info->tick;
}

static SimConfig short_config(void)
{
    SimConfig config;
    sim_config_default(&config);
    config.num_directions = 2;
    config.initial_vehicles = 2;
    config.queue_capacity = QUEUE_CAPACITY;
    sim_config_set_traffic_density(&config, 0);
    config.total_ticks = 4;
    return config;
}

static void test_start_pause_resume_preserves_progress(void)
{
    SimConfig config = short_config();
    SimStats stats;
    SimSession session = {0};
    TickLog log = {{0}, 0};

    CHECK(sim_session_pause(&session) == 0);
    CHECK(sim_session_resume(&session) == 0);
    CHECK(sim_session_stop(&session) == 0);
    CHECK(sim_session_start(&session, &config, &stats, record_tick, &log) == 1);
    CHECK(session.state == SIM_SESSION_RUNNING);
    CHECK(stats.ticks == 0);
    CHECK(sim_session_step(&session) == 1);
    CHECK(log.count == 1 && log.ticks[0] == 0);
    {
        SimStats before_stats = stats;
        VehicleQueue before_queues[SIM_MAX_DIRECTIONS];
        VehicleGenerator before_generator = session.generator;
        unsigned int before_next_tick = session.next_tick;

        memcpy(before_queues, session.queues, sizeof before_queues);
        CHECK(sim_session_pause(&session) == 1);
        CHECK(session.state == SIM_SESSION_PAUSED);
        CHECK(sim_session_step(&session) == 0);
        CHECK(memcmp(&stats, &before_stats, sizeof stats) == 0);
        CHECK(memcmp(session.queues, before_queues, sizeof before_queues) == 0);
        CHECK(memcmp(&session.generator, &before_generator, sizeof before_generator) == 0);
        CHECK(session.next_tick == before_next_tick);
    }
    CHECK(log.count == 1);
    CHECK(sim_session_pause(&session) == 0);
    CHECK(sim_session_start(&session, &config, &stats, record_tick, &log) == 0);
    CHECK(log.count == 1);
    CHECK(sim_session_resume(&session) == 1);
    CHECK(session.state == SIM_SESSION_RUNNING);
    CHECK(sim_session_step(&session) == 1);
    CHECK(log.count == 2 && log.ticks[1] == 1);
}

static void test_pause_resume_matches_uninterrupted_vehicle_flow(void)
{
    SimConfig config = short_config();
    SimStats baseline;
    SimStats resumed;
    SimSession session = {0};
    int i;

    CHECK(sim_run(&config, &baseline, NULL, NULL) == 1);
    CHECK(sim_session_start(&session, &config, &resumed, NULL, NULL) == 1);
    CHECK(sim_session_step(&session) == 1);
    CHECK(sim_session_pause(&session) == 1);
    CHECK(sim_session_step(&session) == 0);
    CHECK(sim_session_resume(&session) == 1);
    for (i = 1; i < config.total_ticks; i++) {
        if (i == 2) {
            CHECK(sim_session_pause(&session) == 1);
            CHECK(sim_session_resume(&session) == 1);
        }
        CHECK(sim_session_step(&session) == 1);
    }
    CHECK(session.state == SIM_SESSION_COMPLETED);
    CHECK(resumed.generated == baseline.generated);
    CHECK(resumed.passed == baseline.passed);
    CHECK(resumed.dropped == baseline.dropped);
    CHECK(resumed.remaining == baseline.remaining);
    CHECK(resumed.total_wait == baseline.total_wait);
    CHECK(resumed.max_queue_length == baseline.max_queue_length);
    CHECK(resumed.ticks == baseline.ticks);
    CHECK(session.generator.next_id == (unsigned int)baseline.generated + 1);
}

static void test_stop_while_paused_finalizes_partial_run(void)
{
    SimConfig config = short_config();
    SimStats stats;
    SimSession session = {0};

    CHECK(sim_session_start(&session, &config, &stats, NULL, NULL) == 1);
    CHECK(sim_session_step(&session) == 1);
    CHECK(sim_session_pause(&session) == 1);
    CHECK(sim_session_stop(&session) == 1);
    CHECK(session.state == SIM_SESSION_STOPPED);
    CHECK(stats.ticks == 1);
    CHECK(stats.generated == stats.passed + stats.dropped + stats.remaining);
    CHECK(sim_session_resume(&session) == 0);
    CHECK(sim_session_step(&session) == 0);
    CHECK(sim_session_stop(&session) == 0);
}

static void test_stop_while_running_and_before_first_tick(void)
{
    SimConfig config = short_config();
    SimStats stats;
    SimSession session = {0};

    CHECK(sim_session_start(&session, &config, &stats, NULL, NULL) == 1);
    CHECK(sim_session_stop(&session) == 1);
    CHECK(session.state == SIM_SESSION_STOPPED);
    CHECK(stats.ticks == 0);
    CHECK(stats.generated == 0 && stats.passed == 0 && stats.dropped == 0 && stats.remaining == 0);
    CHECK(stats_is_conserved(&stats) == 1);

    CHECK(sim_session_start(&session, &config, &stats, NULL, NULL) == 1);
    CHECK(sim_session_step(&session) == 1);
    CHECK(sim_session_stop(&session) == 1);
    CHECK(session.state == SIM_SESSION_STOPPED);
    CHECK(stats.ticks == 1);
    CHECK(stats_is_conserved(&stats) == 1);
}

static void test_start_and_natural_completion(void)
{
    SimConfig config = short_config();
    SimStats stats;
    SimSession session = {0};
    int i;

    CHECK(sim_session_start(&session, &config, &stats, NULL, NULL) == 1);
    for (i = 0; i < config.total_ticks; i++) CHECK(sim_session_step(&session) == 1);
    CHECK(session.state == SIM_SESSION_COMPLETED);
    CHECK(stats.ticks == (unsigned int)config.total_ticks);
    CHECK(stats.generated == stats.passed + stats.dropped + stats.remaining);
    CHECK(sim_session_step(&session) == 0);
    CHECK(sim_session_pause(&session) == 0);
    CHECK(sim_session_stop(&session) == 0);
}

static void test_invalid_start_does_not_begin(void)
{
    SimConfig config = short_config();
    SimStats stats;
    SimSession session = {0};

    config.total_ticks = 0;
    CHECK(sim_session_start(&session, &config, &stats, NULL, NULL) == 0);
    CHECK(sim_session_start(NULL, &config, &stats, NULL, NULL) == 0);
}

static void test_finished_sessions_can_restart_and_repeated_runs_match(void)
{
    SimConfig config = short_config();
    SimStats first;
    SimStats second;
    SimSession session = {0};
    int i;

    CHECK(sim_session_start(&session, &config, &first, NULL, NULL) == 1);
    for (i = 0; i < config.total_ticks; i++) CHECK(sim_session_step(&session) == 1);
    CHECK(session.state == SIM_SESSION_COMPLETED);
    CHECK(sim_session_start(&session, &config, &second, NULL, NULL) == 1);
    CHECK(session.generator.next_id == 1);
    CHECK(session.next_tick == 0 && session.audit_count == 0);
    CHECK(second.generated == 0 && second.passed == 0 && second.dropped == 0);
    CHECK(session.previous_signal[0] == SIM_SIGNAL_RED);
    CHECK(session.queues[0].size == 0 && session.queues[0].capacity == config.queue_capacity);
    for (i = 0; i < config.total_ticks; i++) CHECK(sim_session_step(&session) == 1);
    CHECK(session.state == SIM_SESSION_COMPLETED);
    CHECK(first.generated == second.generated);
    CHECK(first.passed == second.passed);
    CHECK(first.remaining == second.remaining);
    CHECK(first.dropped == second.dropped);
    CHECK(first.total_wait == second.total_wait);
    CHECK(stats_is_conserved(&second) == 1);

    CHECK(sim_session_stop(&session) == 0); /* completed sessions remain terminal */
    config.initial_vehicles = 1;
    config.total_ticks = 1;
    CHECK(sim_session_start(&session, &config, &second, NULL, NULL) == 1);
    CHECK(second.generated == 0 && session.generator.next_id == 1);
    CHECK(sim_session_step(&session) == 1);
    CHECK(session.state == SIM_SESSION_COMPLETED);
    CHECK(second.generated == 2);
    CHECK(stats_is_conserved(&second));
}

int main(void)
{
    TEST_RUN(test_start_pause_resume_preserves_progress);
    TEST_RUN(test_pause_resume_matches_uninterrupted_vehicle_flow);
    TEST_RUN(test_stop_while_paused_finalizes_partial_run);
    TEST_RUN(test_stop_while_running_and_before_first_tick);
    TEST_RUN(test_start_and_natural_completion);
    TEST_RUN(test_invalid_start_does_not_begin);
    TEST_RUN(test_finished_sessions_can_restart_and_repeated_runs_match);
    return TEST_SUMMARY();
}
