<file path="patches/0003-S1TMS-8-bounded-strict-console-input-validation.patch">
From bf25e81d02705fcb89b6824fd6408ee48b83f3fa Mon Sep 17 00:00:00 2001
From: Neal <nealpunjabi196@gmail.com>
Date: Thu, 29 Oct 2026 08:56:43 +0000
Subject: [PATCH 3/5] S1TMS-8: bounded, strict console input validation

- new input module: read_line_bounded never overruns its buffer and discards
  the rest of an oversized line; parse_int_strict rejects empty, non-numeric,
  trailing-junk, negative, zero and overflowing values without undefined
  behaviour; prompt_int re-asks until valid
- main.c getValidatedInput now delegates to it (same prompts and messages).
  Fixes the old fgets/sscanf loop where a line over 99 characters was split
  and its tail accepted as the next answer
- add tests/test_input.c with min-1/min/max/max+1 boundaries (density 1-100,
  green duration 1-120) and error-input cases

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_015D1Ltje8dSmxKDaSCetk2G
---
 input.c            | 119 ++++++++++++++++++++++++++
 input.h            |  39 +++++++++
 main.c             |  32 ++-----
 tests/test_input.c | 204 +++++++++++++++++++++++++++++++++++++++++++++
 4 files changed, 369 insertions(+), 25 deletions(-)
 create mode 100644 input.c
 create mode 100644 input.h
 create mode 100644 tests/test_input.c

diff --git a/input.c b/input.c
new file mode 100644
index 0000000..3c7289f
--- /dev/null
+++ b/input.c
@@ -0,0 +1,119 @@
+#include "input.h"
+
+#include <ctype.h>
+#include <errno.h>
+#include <stdlib.h>
+#include <string.h>
+
+int read_line_bounded(FILE *in, char *buf, size_t size)
+{
+    size_t length;
+    int c;
+
+    if (in == NULL || buf == NULL || size < 2) {
+        return -1;
+    }
+
+    if (fgets(buf, (int)size, in) == NULL) {
+        buf[0] = '\0';
+        return -1;
+    }
+
+    length = strlen(buf);
+    if (length > 0 && buf[length - 1] == '\n') {
+        buf[--length] = '\0';
+        if (length > 0 && buf[length - 1] == '\r') {
+            buf[length - 1] = '\0';
+        }
+        return 1;
+    }
+
+    /*
+     * No newline was read: this is either the last line of the input, a line
+     * that exactly filled the buffer, or an oversized line.
+     */
+    c = getc(in);
+    if (c == EOF || c == '\n') {
+        return 1;
+    }
+
+    while (c != '\n' && c != EOF) {
+        c = getc(in);   /* discard the rest of the oversized line */
+    }
+
+    return 0;
+}
+
+InputStatus parse_int_strict(const char *text, int min, int max, int *out)
+{
+    char *end;
+    long value;
+
+    if (text == NULL || out == NULL) {
+        return INPUT_NOT_A_NUMBER;
+    }
+
+    while (isspace((unsigned char)*text)) {
+        text++;
+    }
+    if (*text == '\0') {
+        return INPUT_NOT_A_NUMBER;
+    }
+
+    errno = 0;
+    value = strtol(text, &end, 10);
+    if (end == text) {
+        return INPUT_NOT_A_NUMBER;
+    }
+
+    while (isspace((unsigned char)*end)) {
+        end++;
+    }
+    if (*end != '\0') {
+        return INPUT_NOT_A_NUMBER;
+    }
+
+    if (errno == ERANGE || value < (long)min || value > (long)max) {
+        return INPUT_OUT_OF_RANGE;
+    }
+
+    *out = (int)value;
+    return INPUT_OK;
+}
+
+int prompt_int(FILE *in, FILE *out, const char *prompt,
+               int min, int max, int *value)
+{
+    char line[INPUT_MAX_LINE];
+    int read_status;
+    InputStatus status;
+
+    if (in == NULL || out == NULL || value == NULL) {
+        return -1;
+    }
+
+    for (;;) {
+        fputs(prompt != NULL ? prompt : "", out);
+        fflush(out);
+
+        read_status = read_line_bounded(in, line, sizeof line);
+        if (read_status < 0) {
+            return -1;
+        }
+        if (read_status == 0) {
+            fprintf(out, "Error: Input is too long.\n");
+            continue;
+        }
+
+        status = parse_int_strict(line, min, max, value);
+        if (status == INPUT_OK) {
+            return 1;
+        }
+        if (status == INPUT_NOT_A_NUMBER) {
+            fprintf(out, "Error: Enter a valid whole number.\n");
+        } else {
+            fprintf(out, "Error: Enter a value between %d and %d.\n",
+                    min, max);
+        }
+    }
+}
diff --git a/input.h b/input.h
new file mode 100644
index 0000000..dd6000d
--- /dev/null
+++ b/input.h
@@ -0,0 +1,39 @@
+#ifndef INPUT_H
+#define INPUT_H
+
+#include <stddef.h>
+#include <stdio.h>
+
+/* Longest accepted input line, including the terminator. Longer lines are rejected. */
+#define INPUT_MAX_LINE 64
+
+typedef enum {
+    INPUT_OK = 0,
+    INPUT_NOT_A_NUMBER,
+    INPUT_OUT_OF_RANGE
+} InputStatus;
+
+/*
+ * Reads one line into buf with the newline (and any CR) removed. Never writes
+ * more than size bytes.
+ * Returns 1 on success, 0 if the line was too long (the rest of that line is
+ * discarded so the next read starts cleanly), -1 on end of input or bad arguments.
+ */
+int read_line_bounded(FILE *in, char *buf, size_t size);
+
+/*
+ * Strict whole-number parse: surrounding spaces are allowed; anything else
+ * (empty text, letters, decimals, trailing characters) is INPUT_NOT_A_NUMBER.
+ * A number that is outside [min, max], including one too large for an int,
+ * is INPUT_OUT_OF_RANGE. *out is written only on INPUT_OK.
+ */
+InputStatus parse_int_strict(const char *text, int min, int max, int *out);
+
+/*
+ * Prints the prompt and re-asks until the user enters a whole number in
+ * [min, max]. Returns 1 on success, -1 if input ends or arguments are invalid.
+ */
+int prompt_int(FILE *in, FILE *out, const char *prompt,
+               int min, int max, int *value);
+
+#endif
