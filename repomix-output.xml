<file path="simulation.c">
#include "simulation.h"

#include <stdio.h>
#include <string.h>

#include "vehicle_generator.h"

void sim_config_default(SimConfig *config)
{
    if (config == NULL) {
        return;
    }

    config->num_directions = SIM_MAX_DIRECTIONS;
    config->initial_vehicles = 10;
    config->queue_capacity = QUEUE_CAPACITY;
    config->green_ticks = 5;
    config->yellow_ticks = 1;
    config->discharge_per_tick = 1;
    config->total_ticks = 120;
    sim_config_set_traffic_density(config, 20);   /* one vehicle every 5 ticks per direction */
}

void sim_config_set_traffic_density(SimConfig *config, int vehicles_per_100_ticks)
{
    int d;

    if (config == NULL) {
        return;
    }

    for (d = 0; d < SIM_MAX_DIRECTIONS; d++) {
        config->arrival_rate[d] = vehicles_per_100_ticks;
    }
}

static int in_range(const char *name, int value, int min, int max,
                    char *error, size_t error_size)
{
    if (value >= min && value <= max) {
        return 1;
    }

    if (error != NULL && error_size > 0) {
        snprintf(error, error_size, "%s must be between %d and %d",
                 name, min, max);
    }

    return 0;
}

static int densities_in_range(const SimConfig *config, char *error, size_t error_size)
{
    int d;

    for (d = 0; d < config->num_directions; d++) {
        if (!in_range("traffic density", config->arrival_rate[d],
                      0, SIM_MAX_ARRIVAL_RATE, error, error_size)) {
            return 0;
        }
    }

    return 1;
}

int sim_config_validate(const SimConfig *config, char *error, size_t error_size)
{
    if (error != NULL && error_size > 0) {
        error[0] = '\0';
    }

    if (config == NULL) {
        if (error != NULL && error_size > 0) {
            snprintf(error, error_size, "configuration is missing");
        }
        return 0;
    }

    /* num_directions is checked first: the density check below relies on it. */
    return in_range("number of directions", config->num_directions,
                    SIM_MIN_DIRECTIONS, SIM_MAX_DIRECTIONS, error, error_size)
        && in_range("queue capacity", config->queue_capacity,
                    1, QUEUE_CAPACITY, error, error_size)
        && in_range("initial vehicles", config->initial_vehicles,
                    0, config->queue_capacity, error, error_size)
        && densities_in_range(config, error, error_size)
        && in_range("green duration", config->green_ticks,
                    SIM_MIN_GREEN_TICKS, SIM_MAX_GREEN_TICKS, error, error_size)
        && in_range("yellow duration", config->yellow_ticks,
                    SIM_MIN_YELLOW_TICKS, SIM_MAX_YELLOW_TICKS, error, error_size)
        && in_range("vehicles released per green tick", config->discharge_per_tick,
                    SIM_MIN_DISCHARGE, SIM_MAX_DISCHARGE, error, error_size)
        && in_range("simulated ticks", config->total_ticks,
                    SIM_MIN_TICKS, SIM_MAX_TICKS, error, error_size);
}

SimSignal sim_signal_at(const SimConfig *config, int direction, unsigned int tick)
{
    unsigned int phase_length;
    unsigned int position;
    int active;
    int within;

    if (config == NULL || direction < 0 || direction >= config->num_directions ||
        config->num_directions < SIM_MIN_DIRECTIONS ||
        config->num_directions > SIM_MAX_DIRECTIONS ||
        config->green_ticks < SIM_MIN_GREEN_TICKS ||
        config->green_ticks > SIM_MAX_GREEN_TICKS ||
        config->yellow_ticks < SIM_MIN_YELLOW_TICKS ||
        config->yellow_ticks > SIM_MAX_YELLOW_TICKS) {
        return SIM_SIGNAL_RED;
    }

    phase_length = (unsigned int)(config->green_ticks + config->yellow_ticks);
    position = tick % (phase_length * (unsigned int)config->num_directions);
    active = (int)(position / phase_length);
    within = (int)(position % phase_length);

    if (direction != active) {
        return SIM_SIGNAL_RED;
    }

    return within < config->green_ticks ? SIM_SIGNAL_GREEN : SIM_SIGNAL_YELLOW;
}

/* Returns the ticks left in this signal state, or until this direction is green. */
int sim_signal_remaining_at(const SimConfig *config, int direction, unsigned int tick)
{
    int phase_length;
    int cycle_length;
    int position;
    int active_direction;
    int within_phase;
    int direction_start;

    if (config == NULL || direction < 0 || direction >= config->num_directions ||
        config->num_directions < SIM_MIN_DIRECTIONS ||
        config->num_directions > SIM_MAX_DIRECTIONS ||
        config->green_ticks < SIM_MIN_GREEN_TICKS ||
        config->green_ticks > SIM_MAX_GREEN_TICKS ||
        config->yellow_ticks < SIM_MIN_YELLOW_TICKS ||
        config->yellow_ticks > SIM_MAX_YELLOW_TICKS) {
        return 0;
    }

    phase_length = config->green_ticks + config->yellow_ticks;
    cycle_length = phase_length * config->num_directions;
    position = (int)(tick % (unsigned int)cycle_length);
    active_direction = position / phase_length;
    within_phase = position % phase_length;

    if (direction == active_direction) {
        return within_phase < config->green_ticks
            ? config->green_ticks - within_phase
            : config->yellow_ticks - (within_phase - config->green_ticks);
    }

    direction_start = direction * phase_length;
    return (direction_start - position + cycle_length) % cycle_length;
}

const char *sim_signal_name(SimSignal signal)
{
    switch (signal) {
        case SIM_SIGNAL_GREEN:  return "GREEN";
        case SIM_SIGNAL_YELLOW: return "YELLOW";
        case SIM_SIGNAL_RED:    return "RED";
        default:                return "UNKNOWN";
    }
}

/*
 * Puts a freshly generated vehicle into the queue of its own direction and
 * records it. The queue is chosen by the caller from the direction the vehicle
 * was generated for, so vehicles can never end up in another direction's queue.
 */
static void admit_vehicle(VehicleQueue *queue, Vehicle vehicle, int direction,
                          SimStats *stats, SimTickInfo *info)
{
    stats_record_generated(stats);
    info->generated[direction]++;

    if (!enqueue(queue, vehicle)) {
        info->dropped[direction]++;
    }
}

static void session_finish(SimSession *session, SimSessionState state)
{
    int d;

    if (session->state == SIM_SESSION_STOPPED ||
        session->state == SIM_SESSION_COMPLETED) {
        return;
    }
    for (d = 0; d < session->config.num_directions; d++) {
        session->stats->dropped += session->queues[d].dropped;
        session->stats->remaining += (unsigned long)session->queues[d].size;
    }
    session->stats->ticks = session->next_tick;
    session->state = state;
}

int sim_session_start(SimSession *session, const SimConfig *config,
                      SimStats *stats, SimTickCallback callback, void *user)
{
    int d;

    if (session == NULL || config == NULL || stats == NULL ||
        (session->state != SIM_SESSION_IDLE &&
         session->state != SIM_SESSION_STOPPED &&
         session->state != SIM_SESSION_COMPLETED) ||
        !sim_config_validate(config, NULL, 0) ||
        !vg_init(&session->generator, config->num_directions, config->arrival_rate)) {
        return 0;
    }
    session->config = *config;
    session->stats = stats;
    session->callback = callback;
    session->user = user;
    session->next_tick = 0;
    session->audit_count = 0;
    stats_init(stats);
    for (d = 0; d < SIM_MAX_DIRECTIONS; d++) {
        queue_init(&session->queues[d]);
        session->queues[d].capacity = config->queue_capacity;

        /* Before the simulation begins, all signals are RED. */
        session->previous_signal[d] = SIM_SIGNAL_RED;
    }

    session->state = SIM_SESSION_RUNNING;
    return 1;
    }

int sim_session_pause(SimSession *session)
{
    if (session == NULL || session->state != SIM_SESSION_RUNNING) return 0;
    session->state = SIM_SESSION_PAUSED;
    return 1;
}

int sim_session_resume(SimSession *session)
{
    if (session == NULL || session->state != SIM_SESSION_PAUSED) return 0;
    session->state = SIM_SESSION_RUNNING;
    return 1;
}

int sim_session_stop(SimSession *session)
{
    if (session == NULL || (session->state != SIM_SESSION_RUNNING &&
        session->state != SIM_SESSION_PAUSED)) return 0;
    session_finish(session, SIM_SESSION_STOPPED);
    return 1;
}


int sim_session_step(SimSession *session)
{
    SimTickInfo info;
    Vehicle vehicle;
    unsigned int tick;
    int d;
    int k;

    if (session == NULL || session->state != SIM_SESSION_RUNNING) {
        return 0;
    }

    if (session->next_tick >= (unsigned int)session->config.total_ticks) {
        session_finish(session, SIM_SESSION_COMPLETED);
        return 0;
    }

    tick = session->next_tick;
    memset(&info, 0, sizeof info);
    info.tick = tick;
    info.num_directions = session->config.num_directions;

    /* 1. Arrivals. */
    if (tick == 0) {
        for (d = 0; d < session->config.num_directions; d++) {
            for (k = 0; k < session->config.initial_vehicles; k++) {
                admit_vehicle(&session->queues[d],
                              vg_new_vehicle(&session->generator, tick),
                              d, session->stats, &info);
            }
        }
    }

    for (d = 0; d < session->config.num_directions; d++) {
        if (vg_arrival(&session->generator, d, tick, &vehicle)) {
            admit_vehicle(&session->queues[d], vehicle, d,
                          session->stats, &info);
        }
    }

    /* 2. Sample queue peaks after arrivals. */
    for (d = 0; d < session->config.num_directions; d++) {
        stats_record_queue_length(session->stats, session->queues[d].size);
    }

    /* 3. Process signal changes and vehicle departures. */
    for (d = 0; d < session->config.num_directions; d++) {
        SimSignal current_signal;

        current_signal = sim_signal_at(&session->config, d, tick);

        /* Record every signal transition in chronological order. */
        if (current_signal != session->previous_signal[d]) {
            if (session->audit_count <
                sizeof session->audit_log / sizeof session->audit_log[0]) {

                SimSignalAuditEntry *entry =
                    &session->audit_log[session->audit_count];

                entry->tick = tick;
                entry->direction = d;
                entry->previous_signal = session->previous_signal[d];
                entry->new_signal = current_signal;

                session->audit_count++;
            }

            session->previous_signal[d] = current_signal;
        }

        info.signal[d] = current_signal;
        info.remaining_duration[d] =
            sim_signal_remaining_at(&session->config, d, tick);

        if (current_signal == SIM_SIGNAL_GREEN) {
            for (k = 0; k < session->config.discharge_per_tick; k++) {
                if (!dequeue(&session->queues[d], &vehicle)) {
                    break;
                }

                stats_record_departure(
                    session->stats, tick - vehicle.arrival_tick);

                info.departed_id[d][info.departed[d]] = vehicle.id;
                info.departed[d]++;
            }
        }

        info.queue_length[d] = session->queues[d].size;
    }

    if (session->callback != NULL) {
        session->callback(&info, session->user);
    }

    session->next_tick++;

    if (session->next_tick == (unsigned int)session->config.total_ticks) {
        session_finish(session, SIM_SESSION_COMPLETED);
    }

    return 1;
}


size_t sim_session_audit_count(const SimSession *session)
{
    if (session == NULL) {
        return 0;
    }

    return session->audit_count;
}

const SimSignalAuditEntry *sim_session_audit_get(
    const SimSession *session, size_t index)
{
    if (session == NULL || index >= session->audit_count) {
        return NULL;
    }

    return &session->audit_log[index];
}

int sim_run(const SimConfig *config, SimStats *stats,
            SimTickCallback callback, void *user)
{
    SimSession session = {0};

    if (!sim_session_start(&session, config, stats, callback, user)) {
        return 0;
    }
    while (session.state == SIM_SESSION_RUNNING) {
        (void)sim_session_step(&session);
    }
    return 1;
}
</file>

<file path="simulation.h">
#ifndef SIMULATION_H
#define SIMULATION_H

#include <stddef.h>

#include "queue.h"
#include "stats.h"
#include "vehicle_generator.h"

#define SIM_MIN_DIRECTIONS 2
#define SIM_MAX_DIRECTIONS VG_MAX_DIRECTIONS
#define SIM_MAX_ARRIVAL_RATE VG_MAX_RATE
#define SIM_MIN_GREEN_TICKS 1
#define SIM_MAX_GREEN_TICKS 120
#define SIM_MIN_YELLOW_TICKS 1
#define SIM_MAX_YELLOW_TICKS 30
#define SIM_MIN_DISCHARGE 1
#define SIM_MAX_DISCHARGE 10
#define SIM_MIN_TICKS 1
#define SIM_MAX_TICKS 10000

typedef enum {
    SIM_SIGNAL_RED = 0,
    SIM_SIGNAL_GREEN,
    SIM_SIGNAL_YELLOW
} SimSignal;

/* One recorded change in a direction's traffic signal. */
typedef struct {
    unsigned int tick;
    int direction;
    SimSignal previous_signal;
    SimSignal new_signal;
} SimSignalAuditEntry;

/*
 * Time is measured in logical ticks (1 tick = 1 simulated second); ticks are
 * numbered from 0. Directions are numbered 0..3 (North, South, East, West) and
 * each has its own bounded queue. Directions take turns: one is GREEN for
 * green_ticks, then YELLOW for yellow_ticks, while all others are RED.
 *
 * Every tick, vehicles arrive first and then the green direction releases
 * vehicles. Arrivals come from the VehicleGenerator: at tick 0 the initial
 * vehicles are placed in every queue, and from then on each direction receives
 * vehicles at its own traffic density (arrival_rate).
 */
typedef struct {
    int num_directions;      /* SIM_MIN_DIRECTIONS .. SIM_MAX_DIRECTIONS */
    int initial_vehicles;    /* waiting in every direction at tick 0 (0 .. QUEUE_CAPACITY) */
    int queue_capacity;      /* logical queue capacity (1 .. QUEUE_CAPACITY) */
    int arrival_rate[SIM_MAX_DIRECTIONS]; /* traffic density: new vehicles per 100 ticks, per
                                             direction, 0 .. SIM_MAX_ARRIVAL_RATE.
                                             Only the first num_directions entries are used. */
    int green_ticks;
    int yellow_ticks;
    int discharge_per_tick;  /* vehicles that can leave per green tick */
    int total_ticks;
} SimConfig;

/* Snapshot passed to the observer after every tick. */
typedef struct {
    unsigned int tick;
    int num_directions;
    SimSignal signal[SIM_MAX_DIRECTIONS];
    int remaining_duration[SIM_MAX_DIRECTIONS]; /* remaining ticks in the current signal state */
    int generated[SIM_MAX_DIRECTIONS];     /* vehicles created for this direction this tick
                                              (including any dropped because the queue was full) */
    int queue_length[SIM_MAX_DIRECTIONS];  /* at the end of the tick */
    int departed[SIM_MAX_DIRECTIONS];      /* vehicles that passed this tick */
    unsigned int departed_id[SIM_MAX_DIRECTIONS][SIM_MAX_DISCHARGE]; /* their IDs, oldest first;
                                              only the first departed[d] entries are meaningful */
    int dropped[SIM_MAX_DIRECTIONS];       /* arrivals rejected this tick (queue full) */
} SimTickInfo;

typedef void (*SimTickCallback)(const SimTickInfo *info, void *user);

typedef enum {
    SIM_SESSION_IDLE = 0,
    SIM_SESSION_RUNNING,
    SIM_SESSION_PAUSED,
    SIM_SESSION_STOPPED,
    SIM_SESSION_COMPLETED
} SimSessionState;

/* Mutable state for a controllable simulation. Zero-initialize before first use. */
typedef struct {
    SimConfig config;
    SimStats *stats;
    SimTickCallback callback;
    void *user;
    VehicleQueue queues[SIM_MAX_DIRECTIONS];
    VehicleGenerator generator;
    unsigned int next_tick;
    SimSessionState state;

    /* Signal-change audit history. */
    SimSignalAuditEntry audit_log[2 * SIM_MAX_TICKS];
    size_t audit_count;

    /* Previous signal state for transition detection. */
    SimSignal previous_signal[SIM_MAX_DIRECTIONS];
} SimSession;
void sim_config_default(SimConfig *config);

/* Sets the same traffic density (vehicles per 100 ticks) for every direction. */
void sim_config_set_traffic_density(SimConfig *config, int vehicles_per_100_ticks);

/*
 * Returns 1 if every field is in range. Otherwise returns 0 and, when error is
 * not NULL, writes a short message naming the offending field.
 */
int sim_config_validate(const SimConfig *config, char *error, size_t error_size);

/* Start only an IDLE, STOPPED, or COMPLETED session; active sessions are preserved. */
int sim_session_start(SimSession *session, const SimConfig *config,
                      SimStats *stats, SimTickCallback callback, void *user);
int sim_session_pause(SimSession *session);
int sim_session_resume(SimSession *session);
int sim_session_stop(SimSession *session);
/* Advances exactly one tick while RUNNING; returns 1 when a tick was run. */
int sim_session_step(SimSession *session);
/* Number of signal changes recorded in the session. */
size_t sim_session_audit_count(const SimSession *session);

/* Retrieve an audit entry by chronological index; NULL if invalid. */
const SimSignalAuditEntry *sim_session_audit_get(
    const SimSession *session, size_t index);

/* Signal shown to one direction at a tick (RED for any invalid argument). */
SimSignal sim_signal_at(const SimConfig *config, int direction, unsigned int tick);

/* Remaining ticks in that direction's current signal state at the given tick. */
int sim_signal_remaining_at(const SimConfig *config, int direction, unsigned int tick);

const char *sim_signal_name(SimSignal signal);

/*
 * Runs one simulation: arrivals, then departures, in every tick. Fills stats.
 * callback may be NULL. Returns 1 on success, 0 on invalid arguments or config.
 */
int sim_run(const SimConfig *config, SimStats *stats,
            SimTickCallback callback, void *user);

#endif
</file>

<file path=".github/workflows/ci.yml">
name: Traffic Management System CI

on:
  push:
  pull_request:
  workflow_dispatch:

env:
  # Every warning is an error. -I. lets tests include the project headers.
  CFLAGS: -std=c11 -Wall -Wextra -Wpedantic -Werror -I.

jobs:
  build-and-test:
    name: Build and test (${{ matrix.os }})
    runs-on: ${{ matrix.os }}
    timeout-minutes: 10
    strategy:
      fail-fast: false
      matrix:
        os: [ubuntu-latest, macos-latest, windows-latest]
    defaults:
      run:
        shell: bash

    steps:
      - name: Check out source code
        uses: actions/checkout@v4

      - name: Show compiler
        run: gcc --version

      - name: Compile integrated application
        run: |
          # Every module except the two programs with their own main().
          LIB=$(ls *.c | grep -v -x -e main.c -e traffic_simulation.c)
          gcc $CFLAGS main.c $LIB -o traffic_management

      - name: Compile basic single-direction simulation
        run: gcc $CFLAGS traffic_simulation.c queue.c -o traffic_simulation

      - name: Run application smoke test
        run: |
          # answers: initial vehicles, green duration, traffic density
          python - <<'PY'
          import os
          import subprocess

          executable = "./traffic_management.exe" if os.name == "nt" else "./traffic_management"
          result = subprocess.run(
              [executable], input="start\n" + "\n" * 120 + "no\nquit\n", text=True,
              stdout=subprocess.PIPE, stderr=subprocess.STDOUT, timeout=30,
          )
          with open("run.log", "w", encoding="utf-8") as log:
              log.write(result.stdout)
          if result.returncode != 0:
              raise SystemExit(f"application exited with status {result.returncode}")
          if "Ticks simulated       : 120" not in result.stdout or "Integrity check       : OK" not in result.stdout:
              raise SystemExit("application did not complete its piped-input smoke run")
          PY
          tail -n 12 run.log
          grep -q "Maximum queue length" run.log

      - name: Exercise simulation console controls
        run: |
          printf 'start\nresume\nstep\npause\nstep\nresume\nstep\nstop\nno\nquit\n' | ./traffic_management > controls.log
          grep -q "resume is only valid while paused" controls.log
          grep -q "Paused at tick 1" controls.log
          grep -q "Resumed at tick 1" controls.log
          grep -q "Stopped safely at tick 2" controls.log
          grep -q "Integrity check       : OK" controls.log

      - name: Traffic density controls how many vehicles are generated
        run: |
          # 4 directions x 2 initial vehicles, a 60 second run.
          # Density 0   -> only the 8 initial vehicles.
          # Density 50  -> 8 + 4 x floor(60 x 50 / 100)  = 128.
          # Density 100 -> 8 + 4 x floor(60 x 100 / 100) = 248.
          run_density() {
            rate="$1"
            {
              printf 'edit\ninitial\n2\ngreen\n1\n'
              for direction in 1 2 3 4; do printf 'density\n%s\n%s\n' "$direction" "$rate"; done
              printf 'length\n60\ndone\nstart\n'
              for ((tick = 0; tick < 60; tick++)); do printf '\n'; done
              printf 'no\nquit\n'
            } | ./traffic_management > "density_${rate}.log"
          }
          run_density 0
          grep -q "Vehicles generated    : 8$" density_0.log
          run_density 50
          grep -q "Vehicles generated    : 128$" density_50.log
          run_density 100
          grep -q "Vehicles generated    : 248$" density_100.log
          grep -q "Integrity check       : OK" density_100.log

      - name: Save, load and confirm configuration overwrite
        run: |
          {
            printf 'start\nstop\nyes\nci_config.csv\n'
            printf 'edit\ndensity\n1\n42\ndone\nsave\nci_config.csv\nno\n'
            printf 'save\nci_config.csv\nyes\nquit\n'
          } | ./traffic_management > config_save.log
          grep -q "Save cancelled; existing file was kept." config_save.log
          grep -q "Configuration saved to 'ci_config.csv'." config_save.log
          grep -q '^4,42,20,20,20,' ci_config.csv
          printf 'load\nci_config.csv\nstart\nstop\nno\nquit\n' | ./traffic_management > config_load.log
          grep -q "Configuration loaded." config_load.log
          grep -q "North | Density: 42 vehicles per 100 seconds" config_load.log
          rm -f ci_config.csv

      - name: Application rejects bad configuration input
        run: |
          {
            printf 'edit\ninitial\nabc\n101\n2\n'
            printf 'density\n1\n-1\n101\nxyz\n20\n'
            printf 'length\n0\n10001\n60\ndone\nstart\n'
            for ((tick = 0; tick < 60; tick++)); do printf '\n'; done
            printf 'no\nquit\n'
          } | ./traffic_management > bad_input.log
          grep -q "Error: Enter a valid whole number." bad_input.log
          grep -q "Error: Enter a value between 0 and 100." bad_input.log
          grep -q "Error: Enter a value between 1 and 10000." bad_input.log
          grep -q "Initial vehicles: 2 per direction" bad_input.log
          grep -q "North | Density: 20 vehicles per 100 seconds" bad_input.log
          grep -q "Integrity check       : OK" bad_input.log
          # a 200-character line must be rejected, not split into later answers
          {
            printf 'edit\ninitial\n%0200d\n2\nlength\n60\ndone\nstart\n' 5
            for ((tick = 0; tick < 60; tick++)); do printf '\n'; done
            printf 'no\nquit\n'
          } | ./traffic_management > long_input.log
          grep -q "Error: Input is too long." long_input.log
          grep -q "Initial vehicles: 2 per direction" long_input.log
          # input that ends early must fail cleanly instead of hanging
          if ! printf 'edit\ninitial\n1\n' | ./traffic_management > early_eof.log 2>&1; then
            echo "expected clean exit when input ends during configuration"
            exit 1
          fi
          if grep -q "SIMULATION SUMMARY" early_eof.log; then
            echo "application should not start a run after incomplete configuration input"
            exit 1
          fi

      - name: Run basic simulation smoke test
        run: ./traffic_simulation

      - name: Build and run all tests
        run: |
          LIB=$(ls *.c | grep -v -x -e main.c -e traffic_simulation.c)
          for test_source in tests/test_*.c; do
            test_name=$(basename "$test_source" .c)
            echo "::group::$test_name"
            gcc $CFLAGS "$test_source" $LIB -o "$test_name"
            ./"$test_name"
            echo "::endgroup::"
          done

  memory-safety:
    name: AddressSanitizer, UBSan and Valgrind
    runs-on: ubuntu-latest
    timeout-minutes: 15

    steps:
      - name: Check out source code
        uses: actions/checkout@v4

      - name: Build and run everything with ASan and UBSan
        env:
          SAN: -fsanitize=address,undefined -fno-sanitize-recover=all -fno-omit-frame-pointer -g
        run: |
          LIB=$(ls *.c | grep -v -x -e main.c -e traffic_simulation.c)
          gcc $CFLAGS $SAN main.c $LIB -o traffic_management_san
          { printf 'start\n'; for ((tick = 0; tick < 120; tick++)); do printf '\n'; done; printf 'no\nquit\n'; } | ./traffic_management_san > /dev/null
          { printf 'edit\nlength\n60\ndone\nstart\n'; for ((tick = 0; tick < 60; tick++)); do printf '\n'; done; printf 'no\nquit\n'; } | ./traffic_management_san > /dev/null
          for test_source in tests/test_*.c; do
            test_name=$(basename "$test_source" .c)
            gcc $CFLAGS $SAN "$test_source" $LIB -o "${test_name}_san"
            ./"${test_name}_san"
          done

      - name: Install Valgrind
        run: |
          sudo apt-get update
          sudo apt-get install -y valgrind

      - name: Check for leaks and invalid memory use with Valgrind
        run: |
          LIB=$(ls *.c | grep -v -x -e main.c -e traffic_simulation.c)
          gcc $CFLAGS -g main.c $LIB -o traffic_management_vg
          { printf 'start\n'; for ((tick = 0; tick < 120; tick++)); do printf '\n'; done; printf 'no\nquit\n'; } | valgrind --leak-check=full --error-exitcode=1 ./traffic_management_vg > /dev/null
</file>

<file path="main.c">
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <sys/stat.h>

#include "input.h"
#include "config_file.h"
#include "queue.h"
#include "simulation.h"
#include "stats.h"

#define NUM_DIRECTIONS SIM_MAX_DIRECTIONS

enum Direction {
    NORTH = 0,
    SOUTH,
    EAST,
    WEST
};

static const char *directionNames[NUM_DIRECTIONS] = {
    "North", "South", "East", "West"
};

static int getValidatedInput(const char *prompt, int min, int max)
{
    int value;

    /* Bounded, strict parsing lives in input.c so it can be unit tested. */
    if (prompt_int(stdin, stdout, prompt, min, max, &value) != 1) {
        fprintf(stderr, "Error: Unable to read input.\n");
        exit(EXIT_FAILURE);
    }

    return value;
}

/* Called after every simulation tick to display live traffic status. */
static void displayTick(const SimTickInfo *info, void *user)
{
    int i;
    int arrived = 0;
    int passed = 0;
    int dropped = 0;
    int totalWaiting = 0;
    const SimStats *stats = (const SimStats *)user;

    printf("\n========== LIVE TRAFFIC STATUS ==========\n");
    printf("Tick: %03u\n", info->tick);

    for (i = 0; i < info->num_directions; i++) {
        printf("%-5s | Signal: %-6s | Remaining: %2ds | Queue: %d\n",
               directionNames[i],
               sim_signal_name(info->signal[i]),
               info->remaining_duration[i],
               info->queue_length[i]);

        arrived += info->generated[i];
        passed += info->departed[i];
        dropped += info->dropped[i];
        totalWaiting += info->queue_length[i];
    }

    printf("-----------------------------------------\n");
    printf("Vehicles arrived this tick : %d\n", arrived);
    printf("Vehicles passed this tick  : %d\n", passed);
    printf("Vehicles dropped this tick : %d\n", dropped);

    if (stats != NULL) {
        printf("Total vehicles passed      : %lu\n", stats->passed);
    }

    printf("Total vehicles waiting     : %d\n", totalWaiting);
    printf("=========================================\n");
}


/* Display the chronological traffic signal audit history. */
static void displaySignalAudit(const SimSession *session)
{
    size_t i;
    const SimSignalAuditEntry *entry;

    printf("\n========== SIGNAL CHANGE AUDIT TRAIL ==========\n");

    if (sim_session_audit_count(session) == 0) {
        printf("No signal changes recorded.\n");
    } else {
        printf("%-8s %-12s %-12s %-12s\n",
               "Tick", "Direction", "Previous", "New");

        for (i = 0; i < sim_session_audit_count(session); i++) {
            entry = sim_session_audit_get(session, i);

            if (entry != NULL) {
                printf("%-8u %-12s %-12s %-12s\n",
                       entry->tick,
                       directionNames[entry->direction],
                       sim_signal_name(entry->previous_signal),
                       sim_signal_name(entry->new_signal));
            }
        }
    }

    printf("================================================\n");
}



static void displayConfiguration(const SimConfig *config)
{
    int d;
    printf("\n========== SETTINGS FOR NEXT RUN ==========\n");
    printf("Directions: %d\n", config->num_directions);
    for (d = 0; d < config->num_directions; d++)
        printf("%-5s | Density: %d vehicles per 100 seconds\n",
               directionNames[d], config->arrival_rate[d]);
    printf("Green: %d seconds | Yellow: %d seconds\n",
           config->green_ticks, config->yellow_ticks);
    printf("Queue capacity: %d | Initial vehicles: %d per direction\n",
           config->queue_capacity, config->initial_vehicles);
    printf("Run length: %d seconds\n", config->total_ticks);
    printf("===========================================\n");
}

static int configureOption(SimConfig *config, const char *command)
{
    int value, direction;
    char prompt[128];
    if (strcmp(command, "density") == 0) {
        direction = getValidatedInput("Direction (1-North, 2-South, 3-East, 4-West): ", 1, config->num_directions) - 1;
        snprintf(prompt, sizeof prompt, "%s density (0-%d vehicles per 100 seconds): ", directionNames[direction], SIM_MAX_ARRIVAL_RATE);
        value = getValidatedInput(prompt, 0, SIM_MAX_ARRIVAL_RATE);
        config->arrival_rate[direction] = value;
    } else if (strcmp(command, "directions") == 0) {
        value = getValidatedInput("Number of directions (2-4): ", SIM_MIN_DIRECTIONS, SIM_MAX_DIRECTIONS);
        config->num_directions = value;
    } else if (strcmp(command, "green") == 0) {
        value = getValidatedInput("Green duration (1-120 seconds): ", SIM_MIN_GREEN_TICKS, SIM_MAX_GREEN_TICKS);
        config->green_ticks = value;
    } else if (strcmp(command, "yellow") == 0) {
        value = getValidatedInput("Yellow duration (1-30 seconds): ", SIM_MIN_YELLOW_TICKS, SIM_MAX_YELLOW_TICKS);
        config->yellow_ticks = value;
    } else if (strcmp(command, "capacity") == 0) {
        value = getValidatedInput("Queue capacity (at least current initial vehicles, at most 100): ", config->initial_vehicles > 1 ? config->initial_vehicles : 1, QUEUE_CAPACITY);
        config->queue_capacity = value;
    } else if (strcmp(command, "initial") == 0) {
        value = getValidatedInput("Initial vehicles per direction: ", 0, config->queue_capacity);
        config->initial_vehicles = value;
    } else if (strcmp(command, "length") == 0) {
        value = getValidatedInput("Run length (1-10000 seconds): ", SIM_MIN_TICKS, SIM_MAX_TICKS);
        config->total_ticks = value;
    } else {
        return 0;
    }
    return 1;
}

static int readPath(const char *prompt, char *path, size_t size)
{
    int status;
    for (;;) {
        printf("%s", prompt);
        fflush(stdout);
        status = read_line_bounded(stdin, path, size);
        if (status < 0) return 0;
        if (status == 0) {
            printf("Error: path is too long (maximum %lu characters).\n",
                   (unsigned long)(size - 1));
        } else if (path[0] == '\0') {
            printf("Error: path cannot be empty.\n");
        } else {
            return 1;
        }
    }
}

static int confirm(const char *prompt)
{
    char answer[16];
    int status;
    for (;;) {
        printf("%s", prompt);
        fflush(stdout);
        status = read_command_line(stdin, answer, sizeof answer);
        if (status == 0) return 0;
        if (status < 0) printf("Error: answer is too long.\n");
        else if (strcmp(answer, "yes") == 0 || strcmp(answer, "y") == 0) return 1;
        else if (strcmp(answer, "no") == 0 || strcmp(answer, "n") == 0) return 0;
        else printf("Enter yes or no.\n");
    }
}

static int loadConfiguration(SimConfig *config)
{
    char path[INPUT_MAX_LINE], error[192];
    SimConfig candidate;
    if (!readPath("Configuration CSV path: ", path, sizeof path)) return 0;
    candidate = *config;
    if (!config_csv_load(path, &candidate, error, sizeof error)) {
        printf("Load failed: %s. Current settings were kept.\n", error);
        return 0;
    }
    *config = candidate;
    printf("Configuration loaded.\n");
    displayConfiguration(config);
    return 1;
}

static void saveConfiguration(const SimConfig *config)
{
    char path[INPUT_MAX_LINE], error[192];
    struct stat info;
    for (;;) {
        if (!readPath("Configuration CSV path: ", path, sizeof path)) return;
        if (stat(path, &info) == 0 &&
            !confirm("File exists. Overwrite it? (yes/no): ")) {
            printf("Save cancelled; existing file was kept.\n");
            return;
        }
        if (config_csv_save(path, config, error, sizeof error)) {
            printf("Configuration saved to '%s'.\n", path);
            return;
        }
        printf("Save failed: %s.\n", error);
        if (!confirm("Retry with another path? (yes/no): ")) return;
    }
}

static void editConfiguration(SimConfig *config)
{
    char command[32];
    int status;
    for (;;) {
        printf("\nEdit setting: density, directions, green, yellow, capacity, initial, length, done: ");
        status = read_command_line(stdin, command, sizeof command);
        if (status == 0 || (status == 1 && strcmp(command, "done") == 0)) return;
        if (status < 0) printf("Error: command is too long.\n");
        else if (!configureOption(config, command))
            printf("Error: choose a listed setting or done.\n");
    }
}

static int runOne(const SimConfig *config, SimStats *stats)
{
    SimSession session = {0};
    char command[32];
    int status;

    displayConfiguration(config);
    if (!sim_session_start(&session, config, stats, displayTick, stats)) {
        fprintf(stderr, "Error: Simulation could not start.\n");
        return 0;
    }
    printf("Started. Enter or step advances one tick; pause, resume, and stop control the run.\n");
    while (session.state == SIM_SESSION_RUNNING || session.state == SIM_SESSION_PAUSED) {
        printf("[%s, tick %u/%d] command> ",
               session.state == SIM_SESSION_RUNNING ? "running" : "paused",
               session.next_tick, session.config.total_ticks);
        status = read_command_line(stdin, command, sizeof command);
        if (status < 0) {
            printf("Error: command is too long.\n");
            continue;
        }
        if (status == 0) {
            (void)sim_session_stop(&session);
            printf("\nInput ended; stopped safely at tick %u.\n", stats->ticks);
            break;
        }
        if (strcmp(command, "") == 0 || strcmp(command, "step") == 0) {
            if (!sim_session_step(&session)) printf("Error: session cannot advance now.\n");
        } else if (strcmp(command, "pause") == 0) {
            if (!sim_session_pause(&session)) printf("Error: pause is only valid while running.\n");
            else printf("Paused at tick %u. Generation and signal processing are stopped.\n", session.next_tick);
        } else if (strcmp(command, "resume") == 0) {
            if (!sim_session_resume(&session)) printf("Error: resume is only valid while paused.\n");
            else printf("Resumed at tick %u.\n", session.next_tick);
        } else if (strcmp(command, "stop") == 0) {
            if (sim_session_stop(&session)) printf("Stopped safely at tick %u.\n", stats->ticks);
            else printf("Error: stop is only valid for an active session.\n");
        } else {
            printf("Error: use step, pause, resume, or stop.\n");
        }
    }
    printf("\n");
    displaySignalAudit(&session);
    report_print(stdout, stats);
    return stats_is_conserved(stats);
}

static int runWithControls(SimConfig *config, SimStats *stats)
{
    char command[32];
    int has_run = 0, status;
    for (;;) {
        if (!has_run) printf("\nConfiguration: load, edit, start, quit: ");
        else printf("\nNext: start, edit, load, save, quit: ");
        status = read_command_line(stdin, command, sizeof command);
        if (status == 0) return 1;
        if (status < 0) printf("Error: command is too long.\n");
        else if (strcmp(command, "quit") == 0) return 1;
        else if (strcmp(command, "load") == 0) (void)loadConfiguration(config);
        else if (strcmp(command, "edit") == 0) {
            editConfiguration(config);
            displayConfiguration(config);
        } else if (strcmp(command, "start") == 0) {
            if (!runOne(config, stats)) return 0;
            has_run = 1;
            if (confirm("Save effective configuration? (yes/no): "))
                saveConfiguration(config);
        } else if (has_run && strcmp(command, "save") == 0) {
            saveConfiguration(config);
        } else printf("Error: enter load, edit, start, or quit.\n");
    }
}

int main(void)
{
    SimConfig config;
    SimStats stats;
    char error[96];

    printf("=== TRAFFIC MANAGEMENT CONFIGURATION ===\n");
    sim_config_default(&config);
    if (!sim_config_validate(&config, error, sizeof error)) {
        fprintf(stderr, "Error: %s.\n", error);
        return EXIT_FAILURE;
    }

    printf("\nTRAFFIC MANAGEMENT SIMULATION\n");
    printf("Use load, edit, start, and quit to configure and run the simulation.\n");
    return runWithControls(&config, &stats) ? EXIT_SUCCESS : EXIT_FAILURE;
}
