<file path="tests/test_vehicle_generator.c">
/*
 * Unit tests: VehicleGenerator (F-001, F-002, TC-Gen-01, TC-Gen-02).
 * Density follows the configured rate exactly, IDs are unique across all
 * directions, and directions never influence each other.
 */
#include <stdio.h>
#include <string.h>

#include "test_util.h"
#include "vehicle_generator.h"

#define MAX_IDS 4000

static void test_init_validation(void)
{
    VehicleGenerator vg;
    int ok[4] = { 0, 50, 100, 7 };
    int low[4] = { 10, -1, 10, 10 };
    int high[4] = { 10, 10, 101, 10 };

    CHECK(vg_init(&vg, 4, ok) == 1);
    CHECK(vg_init(&vg, 1, ok) == 1);
    CHECK(vg_init(NULL, 4, ok) == 0);
    CHECK(vg_init(&vg, 4, NULL) == 0);
    CHECK(vg_init(&vg, 0, ok) == 0);
    CHECK(vg_init(&vg, -1, ok) == 0);
    CHECK(vg_init(&vg, VG_MAX_DIRECTIONS + 1, ok) == 0);
    CHECK(vg_init(&vg, 4, low) == 0);                /* -1 */
    CHECK(vg_init(&vg, 4, high) == 0);               /* 101 = max + 1 */
    CHECK(vg_init(&vg, 2, high) == 1);               /* bad entry belongs to an unused direction */
}

static void test_rate_zero_never_generates(void)
{
    VehicleGenerator vg;
    int rates[1] = { 0 };
    Vehicle v;
    unsigned int t;
    int count = 0;

    CHECK(vg_init(&vg, 1, rates) == 1);
    for (t = 0; t < 1000; t++) {
        count += vg_arrival(&vg, 0, t, &v);
    }
    CHECK(count == 0);
}

static void test_rate_hundred_generates_every_tick(void)
{
    VehicleGenerator vg;
    int rates[1] = { 100 };
    Vehicle v;
    unsigned int t;

    CHECK(vg_init(&vg, 1, rates) == 1);
    for (t = 0; t < 300; t++) {
        CHECK(vg_arrival(&vg, 0, t, &v) == 1);
    }
}

static void test_arrivals_follow_density_exactly(void)
{
    static const int rates_to_test[] = { 1, 7, 20, 33, 50, 99 };
    size_t i;

    for (i = 0; i < sizeof rates_to_test / sizeof rates_to_test[0]; i++) {
        VehicleGenerator vg;
        int rate[1];
        Vehicle v;
        unsigned int t;
        unsigned int count = 0;

        rate[0] = rates_to_test[i];
        CHECK(vg_init(&vg, 1, rate) == 1);
        for (t = 0; t < 1000; t++) {
            count += (unsigned int)vg_arrival(&vg, 0, t, &v);
            /* after every prefix of N ticks: exactly floor(N * rate / 100) vehicles */
            CHECK(count == (t + 1) * (unsigned int)rate[0] / 100);
            if (t == 99) {
                CHECK(count == (unsigned int)rate[0]);   /* rate = vehicles per 100 ticks */
            }
        }
        CHECK(count == (unsigned int)rate[0] * 10);
    }
}

static void test_rate_twenty_arrives_every_fifth_tick(void)
{
    static const unsigned int expected[] = { 4, 9, 14, 19 };
    VehicleGenerator vg;
    int rate[1] = { 20 };
    Vehicle v;
    unsigned int t;
    size_t found = 0;

    CHECK(vg_init(&vg, 1, rate) == 1);
    for (t = 0; t < 20; t++) {
        if (vg_arrival(&vg, 0, t, &v)) {
            CHECK(found < 4 && t == expected[found]);
            CHECK(v.arrival_tick == t);                  /* timestamp recorded */
            found++;
        }
    }
    CHECK(found == 4);
}

static void mark_id(unsigned char *seen, unsigned long *total, Vehicle v)
{
    CHECK(v.id >= 1 && v.id < MAX_IDS);
    if (v.id >= 1 && v.id < MAX_IDS) {
        CHECK(seen[v.id] == 0);                          /* never handed out twice */
        seen[v.id] = 1;
    }
    (*total)++;
}

static void test_ids_unique_across_directions_and_initial_batch(void)
{
    static unsigned char seen[MAX_IDS];
    VehicleGenerator vg;
    int rates[4] = { 100, 50, 20, 7 };
    unsigned long total = 0;
    unsigned long id;
    unsigned int t;
    unsigned int k;
    int d;
    Vehicle v;

    memset(seen, 0, sizeof seen);
    CHECK(vg_init(&vg, 4, rates) == 1);

    for (d = 0; d < 4; d++) {
        for (k = 0; k < 3; k++) {
            mark_id(seen, &total, vg_new_vehicle(&vg, 0));
        }
    }
    for (t = 0; t < 500; t++) {
        for (d = 0; d < 4; d++) {
            if (vg_arrival(&vg, d, t, &v)) {
                mark_id(seen, &total, v);
            }
        }
    }

    CHECK(total == 12 + 500 + 250 + 100 + 35);
    for (id = 1; id <= total; id++) {
        CHECK(seen[id] == 1);                            /* IDs run 1..N with no gaps */
    }
    CHECK(seen[total + 1] == 0);
}

static void test_each_direction_has_its_own_density(void)
{
    VehicleGenerator vg;
    int rates[4] = { 100, 50, 20, 0 };
    unsigned int counts[4] = { 0, 0, 0, 0 };
    unsigned int t;
    int d;
    Vehicle v;

    CHECK(vg_init(&vg, 4, rates) == 1);
    for (t = 0; t < 200; t++) {
        for (d = 0; d < 4; d++) {
            counts[d] += (unsigned int)vg_arrival(&vg, d, t, &v);
        }
    }
    CHECK(counts[0] == 200);     /* North: 100 per 100 ticks */
    CHECK(counts[1] == 100);     /* South:  50 per 100 ticks */
    CHECK(counts[2] == 40);      /* East:   20 per 100 ticks */
    CHECK(counts[3] == 0);       /* West:    0 */
}

static void test_directions_do_not_influence_each_other(void)
{
    VehicleGenerator vg;
    int rates[2] = { 50, 50 };
    Vehicle v;
    unsigned int t;
    int arrivals0 = 0;

    CHECK(vg_init(&vg, 2, rates) == 1);
    for (t = 0; t < 10; t++) {
        arrivals0 += vg_arrival(&vg, 0, t, &v);          /* only direction 0 is ticked */
    }
    CHECK(arrivals0 == 5);
    /* direction 1 starts from scratch: credit 50 first, so no vehicle yet, then one */
    CHECK(vg_arrival(&vg, 1, 10, &v) == 0);
    CHECK(vg_arrival(&vg, 1, 11, &v) == 1);
    CHECK(v.arrival_tick == 11);
}

static void test_new_vehicle_records_tick_and_increments_id(void)
{
    VehicleGenerator vg;
    int rates[2] = { 0, 0 };
    Vehicle a;
    Vehicle b;

    CHECK(vg_init(&vg, 2, rates) == 1);
    a = vg_new_vehicle(&vg, 7);
    b = vg_new_vehicle(&vg, 9);
    CHECK(a.id == 1 && a.arrival_tick == 7);
    CHECK(b.id == 2 && b.arrival_tick == 9);
    CHECK(vg_new_vehicle(NULL, 5).id == 0);              /* 0 marks "no vehicle" */
}

static void test_invalid_arguments_are_safe(void)
{
    VehicleGenerator vg;
    int rates[2] = { 100, 100 };
    Vehicle v;

    v.id = 77;
    v.arrival_tick = 88;
    CHECK(vg_init(&vg, 2, rates) == 1);
    CHECK(vg_arrival(NULL, 0, 0, &v) == 0);
    CHECK(vg_arrival(&vg, 0, 0, NULL) == 0);
    CHECK(vg_arrival(&vg, -1, 0, &v) == 0);
    CHECK(vg_arrival(&vg, 2, 0, &v) == 0);               /* one past the last direction */
    CHECK(v.id == 77 && v.arrival_tick == 88);           /* untouched on failure */
    CHECK(vg_arrival(&vg, 0, 0, &v) == 1 && v.id == 1);  /* failed calls consumed no ID */
}

int main(void)
{
    printf("test_vehicle_generator\n");
    TEST_RUN(test_init_validation);
    TEST_RUN(test_rate_zero_never_generates);
    TEST_RUN(test_rate_hundred_generates_every_tick);
    TEST_RUN(test_arrivals_follow_density_exactly);
    TEST_RUN(test_rate_twenty_arrives_every_fifth_tick);
    TEST_RUN(test_ids_unique_across_directions_and_initial_batch);
    TEST_RUN(test_each_direction_has_its_own_density);
    TEST_RUN(test_directions_do_not_influence_each_other);
    TEST_RUN(test_new_vehicle_records_tick_and_increments_id);
    TEST_RUN(test_invalid_arguments_are_safe);
    return TEST_SUMMARY();
}
</file>

<file path="config_file.c">
#include "config_file.h"

#include <stdio.h>
#include <string.h>

#ifndef _WIN32
#include <sys/stat.h>
#endif

#include "input.h"

static const char csv_header[] =
    "directions,north_density,south_density,east_density,west_density,"
    "green_ticks,yellow_ticks,queue_capacity,initial_vehicles,total_ticks";

static const char *const field_names[] = {
    "directions", "north_density", "south_density", "east_density",
    "west_density", "green_ticks", "yellow_ticks", "queue_capacity",
    "initial_vehicles", "total_ticks"
};

static void set_error(char *error, size_t error_size, const char *message)
{
    if (error != NULL && error_size > 0)
        snprintf(error, error_size, "%s", message);
}

static int read_csv_line(FILE *file, char *line)
{
    return read_line_bounded(file, line, CONFIG_CSV_MAX_LINE);
}

static int split_fields(char *line, char **fields, size_t count)
{
    size_t i;
    char *cursor = line;

    for (i = 0; i < count; i++) {
        char *comma;
        fields[i] = cursor;
        comma = strchr(cursor, ',');
        if (i + 1 < count) {
            if (comma == NULL) return 0;
            *comma = '\0';
            cursor = comma + 1;
        } else if (comma != NULL) {
            return 0;
        }
    }
    return 1;
}

static int parse_field(char *text, int min, int max, int *value,
                       size_t index, char *error, size_t error_size)
{
    InputStatus status;
    char message[160];

    if (*text == '\0') {
        snprintf(message, sizeof message, "CSV field '%s' is empty", field_names[index]);
        set_error(error, error_size, message);
        return 0;
    }
    status = parse_int_strict(text, min, max, value);
    if (status != INPUT_OK) {
        snprintf(message, sizeof message, "CSV field '%s' must be a whole number in [%d, %d]",
                 field_names[index], min, max);
        set_error(error, error_size, message);
        return 0;
    }
    return 1;
}

int config_csv_load(const char *path, SimConfig *config,
                    char *error, size_t error_size)
{
    FILE *file;
    char line[CONFIG_CSV_MAX_LINE];
    char *fields[10];
    SimConfig candidate;
    int status, d, value;
    char validation_error[128];

    if (error != NULL && error_size > 0) error[0] = '\0';
    if (path == NULL || config == NULL) {
        set_error(error, error_size, "configuration path or destination is missing");
        return 0;
    }
    file = fopen(path, "rb");
    if (file == NULL) {
        set_error(error, error_size, "could not open configuration file for reading");
        return 0;
    }

    status = read_csv_line(file, line);
    if (status != 1 || strcmp(line, csv_header) != 0) {
        set_error(error, error_size, status == 0 ? "CSV header line is oversized" :
                  "CSV header is missing, malformed, unknown, or duplicated");
        fclose(file);
        return 0;
    }
    status = read_csv_line(file, line);
    if (status != 1) {
        set_error(error, error_size, status == 0 ? "CSV configuration row is oversized" :
                  "CSV configuration row is missing or unreadable");
        fclose(file);
        return 0;
    }
    if (!split_fields(line, fields, sizeof fields / sizeof fields[0])) {
        set_error(error, error_size, "CSV row must contain exactly ten fields");
        fclose(file);
        return 0;
    }

    sim_config_default(&candidate);
    if (!parse_field(fields[0], SIM_MIN_DIRECTIONS, SIM_MAX_DIRECTIONS,
                     &candidate.num_directions, 0, error, error_size)) {
        fclose(file);
        return 0;
    }
    for (d = 0; d < SIM_MAX_DIRECTIONS; d++) candidate.arrival_rate[d] = 0;
    for (d = 0; d < SIM_MAX_DIRECTIONS; d++) {
        if (d < candidate.num_directions) {
            if (!parse_field(fields[d + 1], 0, SIM_MAX_ARRIVAL_RATE,
                             &candidate.arrival_rate[d], (size_t)d + 1,
                             error, error_size)) {
                fclose(file);
                return 0;
            }
        } else if (*fields[d + 1] != '\0') {
            char message[160];
            snprintf(message, sizeof message,
                     "CSV field '%s' must be empty for an inactive direction", field_names[d + 1]);
            set_error(error, error_size, message);
            fclose(file);
            return 0;
        }
    }
    if (!parse_field(fields[5], SIM_MIN_GREEN_TICKS, SIM_MAX_GREEN_TICKS,
                     &candidate.green_ticks, 5, error, error_size) ||
        !parse_field(fields[6], SIM_MIN_YELLOW_TICKS, SIM_MAX_YELLOW_TICKS,
                     &candidate.yellow_ticks, 6, error, error_size) ||
        !parse_field(fields[7], 1, QUEUE_CAPACITY,
                     &candidate.queue_capacity, 7, error, error_size) ||
        !parse_field(fields[8], 0, QUEUE_CAPACITY,
                     &candidate.initial_vehicles, 8, error, error_size) ||
        !parse_field(fields[9], SIM_MIN_TICKS, SIM_MAX_TICKS,
                     &candidate.total_ticks, 9, error, error_size)) {
        fclose(file);
        return 0;
    }
    value = read_csv_line(file, line);
    if (value != -1 || ferror(file)) {
        set_error(error, error_size, value == 0 ? "extra CSV line is oversized" :
                  "CSV file must contain exactly one configuration row");
        fclose(file);
        return 0;
    }
    if (fclose(file) != 0) {
        set_error(error, error_size, "error closing configuration file after reading");
        return 0;
    }
    if (!sim_config_validate(&candidate, validation_error, sizeof validation_error)) {
        char message[192];
        snprintf(message, sizeof message, "invalid configuration: %s", validation_error);
        set_error(error, error_size, message);
        return 0;
    }
    *config = candidate;
    return 1;
}

int config_csv_save(const char *path, const SimConfig *config,
                    char *error, size_t error_size)
{
    FILE *file;
    int d;
    int ok;

    if (error != NULL && error_size > 0) error[0] = '\0';
    if (path == NULL || config == NULL ||
        !sim_config_validate(config, NULL, 0)) {
        set_error(error, error_size, "configuration is missing or invalid");
        return 0;
    }
    file = fopen(path, "wb");
    if (file == NULL) {
        set_error(error, error_size, "could not open configuration file for writing");
        return 0;
    }

    ok = fprintf(file, "%s\n%d", csv_header, config->num_directions) >= 0;
    for (d = 0; ok && d < SIM_MAX_DIRECTIONS; d++) {
        if (fputc(',', file) == EOF) ok = 0;
        if (ok && d < config->num_directions &&
            fprintf(file, "%d", config->arrival_rate[d]) < 0) ok = 0;
    }
    if (ok && fprintf(file, ",%d,%d,%d,%d,%d\n", config->green_ticks,
                      config->yellow_ticks, config->queue_capacity,
                      config->initial_vehicles, config->total_ticks) < 0) ok = 0;
    if (fflush(file) != 0 || ferror(file)) ok = 0;
    if (fclose(file) != 0) ok = 0;
    if (!ok) {
        set_error(error, error_size, "error writing configuration file");
        return 0;
    }
#ifndef _WIN32
    if (chmod(path, S_IRUSR | S_IWUSR) != 0) {
        set_error(error, error_size, "could not restrict configuration file permissions");
        return 0;
    }
#endif
    return 1;
}
