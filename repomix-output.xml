+++ b/simulation.c
@@ -0,0 +1,193 @@
+#include "simulation.h"
+
+#include <stdio.h>
+#include <string.h>
+
+void sim_config_default(SimConfig *config)
+{
+    if (config == NULL) {
+        return;
+    }
+
+    config->num_directions = SIM_MAX_DIRECTIONS;
+    config->initial_vehicles = 10;
+    config->arrival_interval = 5;
+    config->green_ticks = 5;
+    config->yellow_ticks = 1;
+    config->discharge_per_tick = 1;
+    config->total_ticks = 120;
+}
+
+static int in_range(const char *name, int value, int min, int max,
+                    char *error, size_t error_size)
+{
+    if (value >= min && value <= max) {
+        return 1;
+    }
+
+    if (error != NULL && error_size > 0) {
+        snprintf(error, error_size, "%s must be between %d and %d",
+                 name, min, max);
+    }
+
+    return 0;
+}
+
+int sim_config_validate(const SimConfig *config, char *error, size_t error_size)
+{
+    if (error != NULL && error_size > 0) {
+        error[0] = '\0';
+    }
+
+    if (config == NULL) {
+        if (error != NULL && error_size > 0) {
+            snprintf(error, error_size, "configuration is missing");
+        }
+        return 0;
+    }
+
+    return in_range("number of directions", config->num_directions,
+                    SIM_MIN_DIRECTIONS, SIM_MAX_DIRECTIONS, error, error_size)
+        && in_range("initial vehicles", config->initial_vehicles,
+                    0, QUEUE_CAPACITY, error, error_size)
+        && in_range("arrival interval", config->arrival_interval,
+                    0, SIM_MAX_ARRIVAL_INTERVAL, error, error_size)
+        && in_range("green duration", config->green_ticks,
+                    SIM_MIN_GREEN_TICKS, SIM_MAX_GREEN_TICKS, error, error_size)
+        && in_range("yellow duration", config->yellow_ticks,
+                    SIM_MIN_YELLOW_TICKS, SIM_MAX_YELLOW_TICKS, error, error_size)
+        && in_range("vehicles released per green tick", config->discharge_per_tick,
+                    SIM_MIN_DISCHARGE, SIM_MAX_DISCHARGE, error, error_size)
+        && in_range("simulated ticks", config->total_ticks,
+                    SIM_MIN_TICKS, SIM_MAX_TICKS, error, error_size);
+}
+
+SimSignal sim_signal_at(const SimConfig *config, int direction, unsigned int tick)
+{
+    unsigned int phase_length;
+    unsigned int position;
+    int active;
+    int within;
+
+    if (config == NULL || direction < 0 || direction >= config->num_directions ||
+        config->green_ticks < 1 || config->yellow_ticks < 1) {
+        return SIM_SIGNAL_RED;
+    }
+
+    phase_length = (unsigned int)(config->green_ticks + config->yellow_ticks);
+    position = tick % (phase_length * (unsigned int)config->num_directions);
+    active = (int)(position / phase_length);
+    within = (int)(position % phase_length);
+
+    if (direction != active) {
+        return SIM_SIGNAL_RED;
+    }
+
+    return within < config->green_ticks ? SIM_SIGNAL_GREEN : SIM_SIGNAL_YELLOW;
+}
+
+const char *sim_signal_name(SimSignal signal)
+{
+    switch (signal) {
+        case SIM_SIGNAL_GREEN:  return "GREEN";
+        case SIM_SIGNAL_YELLOW: return "YELLOW";
+        case SIM_SIGNAL_RED:    return "RED";
+        default:                return "UNKNOWN";
+    }
+}
+
+/* Creates the next vehicle and queues it; returns 0 if the queue dropped it. */
+static int vehicle_arrives(VehicleQueue *queue, unsigned int *next_id,
+                           unsigned int tick, SimStats *stats)
+{
+    Vehicle vehicle;
+
+    vehicle.id = (*next_id)++;
+    vehicle.arrival_tick = tick;
+    stats_record_generated(stats);
+
+    return enqueue(queue, vehicle);
+}
+
+int sim_run(const SimConfig *config, SimStats *stats,
+            SimTickCallback callback, void *user)
+{
+    VehicleQueue queues[SIM_MAX_DIRECTIONS];
+    SimTickInfo info;
+    unsigned int next_id = 1;
+    unsigned int tick;
+    int d;
+    int k;
+
+    if (config == NULL || stats == NULL ||
+        !sim_config_validate(config, NULL, 0)) {
+        return 0;
+    }
+
+    stats_init(stats);
+    for (d = 0; d < config->num_directions; d++) {
+        queue_init(&queues[d]);
+    }
+
+    for (tick = 0; tick < (unsigned int)config->total_ticks; tick++) {
+        memset(&info, 0, sizeof info);
+        info.tick = tick;
+        info.num_directions = config->num_directions;
+
+        /* 1. Arrivals: the initial vehicles at tick 0, then one per direction per interval. */
+        if (tick == 0) {
+            for (d = 0; d < config->num_directions; d++) {
+                for (k = 0; k < config->initial_vehicles; k++) {
+                    if (!vehicle_arrives(&queues[d], &next_id, tick, stats)) {
+                        info.dropped[d]++;
+                    }
+                }
+            }
+        } else if (config->arrival_interval > 0 &&
+                   tick % (unsigned int)config->arrival_interval == 0) {
+            for (d = 0; d < config->num_directions; d++) {
+                if (!vehicle_arrives(&queues[d], &next_id, tick, stats)) {
+                    info.dropped[d]++;
+                }
+            }
+        }
+
+        /* 2. The queue peak is sampled after arrivals, before anyone leaves. */
+        for (d = 0; d < config->num_directions; d++) {
+            stats_record_queue_length(stats, queues[d].size);
+        }
+
+        /* 3. Departures: only the green direction releases vehicles, oldest first. */
+        for (d = 0; d < config->num_directions; d++) {
+            info.signal[d] = sim_signal_at(config, d, tick);
+
+            if (info.signal[d] == SIM_SIGNAL_GREEN) {
+                for (k = 0; k < config->discharge_per_tick; k++) {
+                    Vehicle vehicle;
+
+                    if (!dequeue(&queues[d], &vehicle)) {
+                        break;
+                    }
+                    stats_record_departure(stats, tick - vehicle.arrival_tick);
+                    info.departed[d]++;
+                }
+            }
+
+            info.queue_length[d] = queues[d].size;
+        }
+
+        if (callback != NULL) {
+            callback(&info, user);
+        }
+    }
+
+    /* Dropped and remaining come from the queues themselves, so the integrity
+     * check in stats_is_conserved compares independent counters. */
+    stats->ticks = (unsigned int)config->total_ticks;
+    for (d = 0; d < config->num_directions; d++) {
+        stats->dropped += queues[d].dropped;
+        stats->remaining += (unsigned long)queues[d].size;
+    }
+
+    return 1;
+}
diff --git a/simulation.h b/simulation.h
new file mode 100644
index 0000000..157063a
--- /dev/null
+++ b/simulation.h
@@ -0,0 +1,74 @@
+#ifndef SIMULATION_H
+#define SIMULATION_H
+
+#include <stddef.h>
+
+#include "queue.h"
+#include "stats.h"
+
+#define SIM_MIN_DIRECTIONS 2
+#define SIM_MAX_DIRECTIONS 4
+#define SIM_MAX_ARRIVAL_INTERVAL 1000
+#define SIM_MIN_GREEN_TICKS 1
+#define SIM_MAX_GREEN_TICKS 120
+#define SIM_MIN_YELLOW_TICKS 1
+#define SIM_MAX_YELLOW_TICKS 30
+#define SIM_MIN_DISCHARGE 1
+#define SIM_MAX_DISCHARGE 10
+#define SIM_MIN_TICKS 1
+#define SIM_MAX_TICKS 10000
+
+typedef enum {
+    SIM_SIGNAL_RED = 0,
+    SIM_SIGNAL_GREEN,
+    SIM_SIGNAL_YELLOW
+} SimSignal;
+
+/*
+ * Time is measured in logical ticks (1 tick = 1 simulated second); ticks are
+ * numbered from 0. Each direction has its own bounded queue. Directions take
+ * turns: one is GREEN for green_ticks, then YELLOW for yellow_ticks, while all
+ * others are RED.
+ */
+typedef struct {
+    int num_directions;      /* SIM_MIN_DIRECTIONS .. SIM_MAX_DIRECTIONS */
+    int initial_vehicles;    /* waiting in every direction at tick 0 (0 .. QUEUE_CAPACITY) */
+    int arrival_interval;    /* afterwards each direction gets one vehicle every N ticks; 0 = none */
+    int green_ticks;
+    int yellow_ticks;
+    int discharge_per_tick;  /* vehicles that can leave per green tick */
+    int total_ticks;
+} SimConfig;
+
+/* Snapshot passed to the observer after every tick. */
+typedef struct {
+    unsigned int tick;
+    int num_directions;
+    SimSignal signal[SIM_MAX_DIRECTIONS];
+    int queue_length[SIM_MAX_DIRECTIONS];  /* at the end of the tick */
+    int departed[SIM_MAX_DIRECTIONS];      /* vehicles that passed this tick */
+    int dropped[SIM_MAX_DIRECTIONS];       /* arrivals rejected this tick (queue full) */
+} SimTickInfo;
+
+typedef void (*SimTickCallback)(const SimTickInfo *info, void *user);
+
+void sim_config_default(SimConfig *config);
+
+/*
+ * Returns 1 if every field is in range. Otherwise returns 0 and, when error is
+ * not NULL, writes a short message naming the offending field.
+ */
+int sim_config_validate(const SimConfig *config, char *error, size_t error_size);
+
+/* Signal shown to one direction at a tick (RED for any invalid argument). */
+SimSignal sim_signal_at(const SimConfig *config, int direction, unsigned int tick);
+const char *sim_signal_name(SimSignal signal);
+
+/*
+ * Runs one simulation: arrivals, then departures, in every tick. Fills stats.
+ * callback may be NULL. Returns 1 on success, 0 on invalid arguments or config.
+ */
+int sim_run(const SimConfig *config, SimStats *stats,
+            SimTickCallback callback, void *user);
+
+#endif
diff --git a/stats.c b/stats.c
new file mode 100644
index 0000000..3b073de
--- /dev/null
+++ b/stats.c
@@ -0,0 +1,88 @@
+#include "stats.h"
+
+#include <string.h>
+
+void stats_init(SimStats *stats)
+{
+    if (stats != NULL) {
+        memset(stats, 0, sizeof *stats);
+    }
+}
+
+void stats_record_generated(SimStats *stats)
+{
+    if (stats != NULL) {
+        stats->generated++;
+    }
+}
+
+void stats_record_departure(SimStats *stats, unsigned int wait_ticks)
+{
+    if (stats != NULL) {
+        stats->passed++;
+        stats->total_wait += wait_ticks;
+    }
+}
+
+void stats_record_queue_length(SimStats *stats, int length)
+{
+    if (stats != NULL && length > stats->max_queue_length) {
+        stats->max_queue_length = length;
+    }
+}
+
+double stats_average_wait(const SimStats *stats)
+{
+    if (stats == NULL || stats->passed == 0) {
+        return 0.0;
+    }
+
+    return (double)stats->total_wait / (double)stats->passed;
+}
+
+int stats_is_conserved(const SimStats *stats)
+{
+    return stats != NULL &&
+           stats->generated ==
+               stats->passed + stats->dropped + stats->remaining;
+}
+
+int report_format(char *buf, size_t size, const SimStats *stats)
+{
+    if (stats == NULL || (buf == NULL && size != 0)) {
+        return -1;
+    }
+
+    return snprintf(buf, size,
+        "========== SIMULATION SUMMARY ==========\n"
+        "Ticks simulated       : %u\n"
+        "Vehicles generated    : %lu\n"
+        "Vehicles processed    : %lu\n"
+        "Vehicles dropped      : %lu (queue full)\n"
+        "Vehicles still queued : %lu\n"
+        "Average wait (ticks)  : %.2f\n"
+        "Maximum queue length  : %d\n"
+        "Integrity check       : %s\n"
+        "========================================\n",
+        stats->ticks,
+        stats->generated,
+        stats->passed,
+        stats->dropped,
+        stats->remaining,
+        stats_average_wait(stats),
+        stats->max_queue_length,
+        stats_is_conserved(stats) ? "OK" : "FAILED");
+}
+
+void report_print(FILE *out, const SimStats *stats)
+{
+    char text[512];
+
+    if (out == NULL) {
+        return;
+    }
+
+    if (report_format(text, sizeof text, stats) >= 0) {
+        fputs(text, out);
+    }
+}
diff --git a/stats.h b/stats.h
new file mode 100644
index 0000000..813d06a
--- /dev/null
+++ b/stats.h
@@ -0,0 +1,35 @@
+#ifndef STATS_H
+#define STATS_H
+
+#include <stddef.h>
+#include <stdio.h>
+
+typedef struct {
+    unsigned long generated;   /* vehicles created (every one is queued or dropped) */
+    unsigned long passed;      /* vehicles that left on green */
+    unsigned long dropped;     /* vehicles rejected because their queue was full */
+    unsigned long remaining;   /* vehicles still queued when the run ended */
+    unsigned long total_wait;  /* sum of (departure tick - arrival tick) over passed vehicles */
+    int max_queue_length;      /* longest single queue observed during the run */
+    unsigned int ticks;        /* ticks simulated */
+} SimStats;
+
+void stats_init(SimStats *stats);
+void stats_record_generated(SimStats *stats);
+void stats_record_departure(SimStats *stats, unsigned int wait_ticks);
+void stats_record_queue_length(SimStats *stats, int length);
+
+/* Average wait in ticks; 0.0 when no vehicle has passed. */
+double stats_average_wait(const SimStats *stats);
+
+/* Integrity check: generated == passed + dropped + remaining. */
+int stats_is_conserved(const SimStats *stats);
+
+/*
+ * Formats the end-of-run summary into buf (always NUL-terminated when size > 0).
+ * Returns the length the full text needs, like snprintf, or -1 on bad arguments.
+ */
+int report_format(char *buf, size_t size, const SimStats *stats);
+void report_print(FILE *out, const SimStats *stats);
+
+#endif
diff --git a/tests/test_simulation.c b/tests/test_simulation.c
new file mode 100644
index 0000000..0771978
--- /dev/null
+++ b/tests/test_simulation.c
@@ -0,0 +1,492 @@
+/*
+ * Integration tests: arrivals -> per-direction queues <-> signals -> stats -> report,
+ * driven by sim_run (S1TMS-6 per-direction queues and signals, S1TMS-7 integrity,
+ * S1TMS-9 report).
+ *
+ * The expected numbers in the "hand computed" tests are derived on paper from the
+ * rules in simulation.h, not copied from program output.
+ */
+#include <stdio.h>
+#include <string.h>
+
+#include "simulation.h"
+#include "test_util.h"
+
+static SimConfig make_config(int dirs, int initial, int interval,
+                             int green, int yellow, int discharge, int ticks)
+{
+    SimConfig c;
+
+    c.num_directions = dirs;
+    c.initial_vehicles = initial;
+    c.arrival_interval = interval;
+    c.green_ticks = green;
+    c.yellow_ticks = yellow;
+    c.discharge_per_tick = discharge;
+    c.total_ticks = ticks;
+    return c;
+}
+
+/* ---- configuration (boundary values: min-1, min, max, max+1) ---- */
+
+static void test_default_config_is_valid(void)
+{
+    SimConfig c;
+    char err[96];
+
+    sim_config_default(&c);
+    CHECK(sim_config_validate(&c, err, sizeof err) == 1);
+    CHECK(err[0] == '\0');
+    sim_config_default(NULL);                       /* must not crash */
+}
+
+#define BOUNDARY(field, lo, hi, name)                                         \
+    do {                                                                      \
+        SimConfig c;                                                          \
+        char err[96];                                                         \
+        sim_config_default(&c);                                               \
+        c.field = (lo);                                                       \
+        CHECK(sim_config_validate(&c, err, sizeof err) == 1);                 \
+        c.field = (hi);                                                       \
+        CHECK(sim_config_validate(&c, err, sizeof err) == 1);                 \
+        c.field = (lo) - 1;                                                   \
+        CHECK(sim_config_validate(&c, err, sizeof err) == 0);                 \
+        CHECK(strstr(err, name) != NULL);                                     \
+        c.field = (hi) + 1;                                                   \
+        CHECK(sim_config_validate(&c, err, sizeof err) == 0);                 \
+        CHECK(strstr(err, name) != NULL);                                     \
+    } while (0)
+
+static void test_config_boundaries(void)
+{
+    BOUNDARY(num_directions, SIM_MIN_DIRECTIONS, SIM_MAX_DIRECTIONS, "directions");
+    BOUNDARY(initial_vehicles, 0, QUEUE_CAPACITY, "initial vehicles");
+    BOUNDARY(arrival_interval, 0, SIM_MAX_ARRIVAL_INTERVAL, "arrival interval");
+    BOUNDARY(green_ticks, SIM_MIN_GREEN_TICKS, SIM_MAX_GREEN_TICKS, "green");
+    BOUNDARY(yellow_ticks, SIM_MIN_YELLOW_TICKS, SIM_MAX_YELLOW_TICKS, "yellow");
+    BOUNDARY(discharge_per_tick, SIM_MIN_DISCHARGE, SIM_MAX_DISCHARGE, "per green tick");
+    BOUNDARY(total_ticks, SIM_MIN_TICKS, SIM_MAX_TICKS, "simulated ticks");
+}
+
+static void test_config_validate_edge_cases(void)
+{
+    SimConfig c;
+    char err[96];
+    char tiny[6];
+
+    CHECK(sim_config_validate(NULL, err, sizeof err) == 0);
+    CHECK(strlen(err) > 0);
+    CHECK(sim_config_validate(NULL, NULL, 0) == 0);
+
+    sim_config_default(&c);
+    c.green_ticks = -1;
+    CHECK(sim_config_validate(&c, NULL, 0) == 0);   /* error buffer is optional */
+    CHECK(sim_config_validate(&c, tiny, sizeof tiny) == 0);
+    CHECK(strlen(tiny) < sizeof tiny);              /* truncated, terminated */
+}
+
+/* ---- signals ---- */
+
+static void test_signal_sequence_for_two_directions(void)
+{
+    /* green 2, yellow 1: each phase lasts 3 ticks, the cycle lasts 6. */
+    static const SimSignal d0[7] = {
+        SIM_SIGNAL_GREEN, SIM_SIGNAL_GREEN, SIM_SIGNAL_YELLOW,
+        SIM_SIGNAL_RED, SIM_SIGNAL_RED, SIM_SIGNAL_RED, SIM_SIGNAL_GREEN
+    };
+    static const SimSignal d1[7] = {
+        SIM_SIGNAL_RED, SIM_SIGNAL_RED, SIM_SIGNAL_RED,
+        SIM_SIGNAL_GREEN, SIM_SIGNAL_GREEN, SIM_SIGNAL_YELLOW, SIM_SIGNAL_RED
+    };
+    SimConfig c = make_config(2, 0, 0, 2, 1, 1, 10);
+    unsigned int t;
+
+    for (t = 0; t < 7; t++) {
+        CHECK(sim_signal_at(&c, 0, t) == d0[t]);
+        CHECK(sim_signal_at(&c, 1, t) == d1[t]);
+    }
+}
+
+static void test_one_direction_active_at_a_time_and_all_served(void)
+{
+    SimConfig c = make_config(4, 0, 0, 5, 2, 1, 10);
+    unsigned int t;
+    int d;
+    int seen_green[4] = { 0, 0, 0, 0 };
+
+    for (t = 0; t < 200; t++) {
+        int not_red = 0;
+
+        for (d = 0; d < 4; d++) {
+            SimSignal s = sim_signal_at(&c, d, t);
+
+            if (s != SIM_SIGNAL_RED) {
+                not_red++;
+            }
+            if (s == SIM_SIGNAL_GREEN && t < 28) {  /* one full cycle = 4 * 7 */
+                seen_green[d] = 1;
+            }
+        }
+        CHECK(not_red == 1);
+    }
+    for (d = 0; d < 4; d++) {
+        CHECK(seen_green[d] == 1);
+    }
+}
+
+static void test_signal_invalid_arguments_are_red(void)
+{
+    SimConfig c = make_config(2, 0, 0, 2, 1, 1, 10);
+
+    CHECK(sim_signal_at(&c, -1, 0) == SIM_SIGNAL_RED);
+    CHECK(sim_signal_at(&c, 2, 0) == SIM_SIGNAL_RED);
+    CHECK(sim_signal_at(NULL, 0, 0) == SIM_SIGNAL_RED);
+    c.green_ticks = 0;
+    CHECK(sim_signal_at(&c, 0, 0) == SIM_SIGNAL_RED);   /* no division by zero */
+    CHECK(strcmp(sim_signal_name(SIM_SIGNAL_GREEN), "GREEN") == 0);
+    CHECK(strcmp(sim_signal_name(SIM_SIGNAL_YELLOW), "YELLOW") == 0);
+    CHECK(strcmp(sim_signal_name(SIM_SIGNAL_RED), "RED") == 0);
+}
+
+/* ---- hand-computed scenarios ---- */
+
+static void test_hand_computed_initial_vehicles_only(void)
+{
+    /*
+     * 2 directions, 2 vehicles each at tick 0 (ids 1,2 in d0; ids 3,4 in d1), no later
+     * arrivals, green 1, yellow 1, one vehicle per green tick, 6 ticks.
+     * Signals: t0 d0 G | t1 d0 Y | t2 d1 G | t3 d1 Y | t4 d0 G | t5 d0 Y
+     *   t0: id1 leaves (wait 0)   t2: id3 leaves (wait 2)   t4: id2 leaves (wait 4)
+     * generated 4, passed 3, dropped 0, remaining 1 (id4)
+     * total wait 0+2+4 = 6, average 2.0, peak queue 2 (after the tick-0 arrivals).
+     */
+    SimConfig c = make_config(2, 2, 0, 1, 1, 1, 6);
+    SimStats s;
+
+    CHECK(sim_run(&c, &s, NULL, NULL) == 1);
+    CHECK(s.generated == 4);
+    CHECK(s.passed == 3);
+    CHECK(s.dropped == 0);
+    CHECK(s.remaining == 1);
+    CHECK(s.total_wait == 6);
+    CHECK(s.max_queue_length == 2);
+    CHECK(s.ticks == 6);
+    CHECK(stats_is_conserved(&s));
+}
+
+static void test_hand_computed_with_ongoing_arrivals(void)
+{
+    /*
+     * 2 directions, nobody waiting at tick 0, one new vehicle per direction at t = 2,4,6,8,
+     * green 2, yellow 1, one per green tick, 9 ticks.
+     * Signals: t0-1 d0 G | t2 d0 Y | t3-4 d1 G | t5 d1 Y | t6-7 d0 G | t8 d0 Y
+     * Arrivals (d0 then d1): t2 ids 1,2 | t4 ids 3,4 | t6 ids 5,6 | t8 ids 7,8
+     *   t3: id2 leaves (arrived 2, wait 1)    t4: id4 leaves (arrived 4, wait 0)
+     *   t6: id1 leaves (arrived 2, wait 4)    t7: id3 leaves (arrived 4, wait 3)
+     * generated 8, passed 4, dropped 0, remaining 4 (ids 5,6,7,8)
+     * total wait 1+0+4+3 = 8, average 2.0
+     * peak queue 3: d0 holds ids 1,3,5 after the t6 arrivals, before id1 leaves.
+     */
+    SimConfig c = make_config(2, 0, 2, 2, 1, 1, 9);
+    SimStats s;
+
+    CHECK(sim_run(&c, &s, NULL, NULL) == 1);
+    CHECK(s.generated == 8);
+    CHECK(s.passed == 4);
+    CHECK(s.dropped == 0);
+    CHECK(s.remaining == 4);
+    CHECK(s.total_wait == 8);
+    CHECK(s.max_queue_length == 3);
+    CHECK(stats_is_conserved(&s));
+}
+
+static void test_hand_computed_multiple_departures_per_green_tick(void)
+{
+    /*
+     * 2 directions, 10 vehicles each at tick 0, no later arrivals, green 2, yellow 1,
+     * up to 3 vehicles per green tick, 6 ticks.
+     * t0: d0 releases 3 (wait 0)   t1: d0 releases 3 (wait 1)
+     * t3: d1 releases 3 (wait 3)   t4: d1 releases 3 (wait 4)
+     * passed 12, remaining 8, total wait 3*0 + 3*1 + 3*3 + 3*4 = 24, average 2.0
+     */
+    SimConfig c = make_config(2, 10, 0, 2, 1, 3, 6);
+    SimStats s;
+
+    CHECK(sim_run(&c, &s, NULL, NULL) == 1);
+    CHECK(s.generated == 20);
+    CHECK(s.passed == 12);
+    CHECK(s.remaining == 8);
+    CHECK(s.dropped == 0);
+    CHECK(s.total_wait == 24);
+    CHECK(s.max_queue_length == 10);
+    CHECK(stats_is_conserved(&s));
+}
+
+typedef struct {
+    int dropped_total;
+    int dropped_at_tick[3];
+} DropProbe;
+
+static void drop_probe(const SimTickInfo *info, void *user)
+{
+    DropProbe *p = (DropProbe *)user;
+    int d;
+
+    for (d = 0; d < info->num_directions; d++) {
+        p->dropped_total += info->dropped[d];
+        if (info->tick < 3) {
+            p->dropped_at_tick[info->tick] += info->dropped[d];
+        }
+    }
+}
+
+static void test_hand_computed_overflow_drops_and_counts(void)
+{
+    /*
+     * 2 directions, queues pre-filled to capacity (100 each, ids 1-100 and 101-200),
+     * a new vehicle per direction every tick, green 1, yellow 1, one per green tick, 3 ticks.
+     *   t0: d0 green, id1 leaves (wait 0) -> d0 holds 99
+     *   t1: id201 joins d0 (back to 100); id202 is dropped, d1 is full. d0 yellow.
+     *   t2: id203 dropped (d0 full), id204 dropped (d1 full). d1 green, id101 leaves (wait 2).
+     * generated 200 + 2 + 2 = 204, passed 2, dropped 3, remaining 100 + 99 = 199
+     * total wait 0 + 2 = 2, peak queue 100.
+     */
+    SimConfig c = make_config(2, QUEUE_CAPACITY, 1, 1, 1, 1, 3);
+    SimStats s;
+    DropProbe p;
+
+    memset(&p, 0, sizeof p);
+    CHECK(sim_run(&c, &s, drop_probe, &p) == 1);
+    CHECK(s.generated == 204);
+    CHECK(s.passed == 2);
+    CHECK(s.dropped == 3);
+    CHECK(s.remaining == 199);
+    CHECK(s.total_wait == 2);
+    CHECK(s.max_queue_length == QUEUE_CAPACITY);
+    CHECK(stats_is_conserved(&s));
+    CHECK(p.dropped_total == 3);                    /* the per-tick view agrees */
+    CHECK(p.dropped_at_tick[0] == 0);
+    CHECK(p.dropped_at_tick[1] == 1);
+    CHECK(p.dropped_at_tick[2] == 2);
+}
+
+/* ---- behaviour checked through the per-tick callback ---- */
+
+typedef struct {
+    int ticks_seen;
+    unsigned int next_tick;
+    int bad_tick_order;
+    int non_green_departures;
+    int non_green_queue_changes;
+    int green_count_errors;
+    int prev_length[SIM_MAX_DIRECTIONS];
+    long departed_total;
+    long dropped_total;
+    int max_end_length;
+    int last_length[SIM_MAX_DIRECTIONS];
+} Probe;
+
+static void probe_cb(const SimTickInfo *info, void *user)
+{
+    Probe *p = (Probe *)user;
+    int d;
+    int greens = 0;
+
+    p->ticks_seen++;
+    if (info->tick != p->next_tick) {
+        p->bad_tick_order++;
+    }
+    p->next_tick = info->tick + 1;
+
+    for (d = 0; d < info->num_directions; d++) {
+        if (info->signal[d] == SIM_SIGNAL_GREEN) {
+            greens++;
+            if (info->queue_length[d] != p->prev_length[d] - info->departed[d]) {
+                p->green_count_errors++;
+            }
+        } else {
+            if (info->departed[d] != 0) {
+                p->non_green_departures++;
+            }
+            if (info->queue_length[d] != p->prev_length[d]) {
+                p->non_green_queue_changes++;       /* only valid with no arrivals */
+            }
+        }
+        p->departed_total += info->departed[d];
+        p->dropped_total += info->dropped[d];
+        if (info->queue_length[d] > p->max_end_length) {
+            p->max_end_length = info->queue_length[d];
+        }
+        p->prev_length[d] = info->queue_length[d];
+        p->last_length[d] = info->queue_length[d];
+    }
+    if (greens > 1) {
+        p->green_count_errors++;
+    }
+}
+
+static void test_only_green_direction_moves_and_others_are_unchanged(void)
+{
+    SimConfig c = make_config(4, 20, 0, 3, 1, 1, 64);   /* no arrivals after tick 0 */
+    SimStats s;
+    Probe p;
+    int d;
+
+    memset(&p, 0, sizeof p);
+    for (d = 0; d < 4; d++) {
+        p.prev_length[d] = 20;
+    }
+    CHECK(sim_run(&c, &s, probe_cb, &p) == 1);
+    CHECK(p.ticks_seen == 64);
+    CHECK(p.bad_tick_order == 0);
+    CHECK(p.non_green_departures == 0);             /* RED/YELLOW directions never release */
+    CHECK(p.non_green_queue_changes == 0);          /* and their queues stay as they were */
+    CHECK(p.green_count_errors == 0);               /* one green at a time, counts consistent */
+    CHECK(p.departed_total == (long)s.passed);
+}
+
+static void test_report_matches_what_was_observed(void)
+{
+    SimConfig c = make_config(4, 30, 3, 4, 1, 1, 150);
+    SimStats s;
+    Probe p;
+    unsigned long queued = 0;
+    int d;
+
+    memset(&p, 0, sizeof p);
+    CHECK(sim_run(&c, &s, probe_cb, &p) == 1);
+    CHECK(p.departed_total == (long)s.passed);
+    CHECK(p.dropped_total == (long)s.dropped);
+    for (d = 0; d < 4; d++) {
+        queued += (unsigned long)p.last_length[d];
+    }
+    CHECK(queued == s.remaining);
+    CHECK(s.max_queue_length >= p.max_end_length);  /* peak includes pre-departure arrivals */
+    CHECK(s.max_queue_length <= QUEUE_CAPACITY);
+    CHECK(s.ticks == 150);
+    CHECK(stats_is_conserved(&s));
+}
+
+/* ---- integrity across many configurations ---- */
+
+static void test_conservation_across_parameter_sweep(void)
+{
+    static const int dirs[] = { 2, 3, 4 };
+    static const int initial[] = { 0, 1, 50, QUEUE_CAPACITY };
+    static const int interval[] = { 0, 1, 3, 7 };
+    static const int green[] = { 1, 3 };
+    static const int discharge[] = { 1, 3 };
+    size_t a, b, c, d, e;
+    int runs = 0;
+
+    for (a = 0; a < sizeof dirs / sizeof dirs[0]; a++)
+    for (b = 0; b < sizeof initial / sizeof initial[0]; b++)
+    for (c = 0; c < sizeof interval / sizeof interval[0]; c++)
+    for (d = 0; d < sizeof green / sizeof green[0]; d++)
+    for (e = 0; e < sizeof discharge / sizeof discharge[0]; e++) {
+        SimConfig cfg = make_config(dirs[a], initial[b], interval[c],
+                                    green[d], 1, discharge[e], 200);
+        SimStats s;
+
+        CHECK(sim_run(&cfg, &s, NULL, NULL) == 1);
+        CHECK(stats_is_conserved(&s));              /* nothing lost, nothing duplicated */
+        CHECK(s.max_queue_length <= QUEUE_CAPACITY);
+        CHECK(s.passed <= s.generated);
+        runs++;
+    }
+    CHECK(runs == 3 * 4 * 4 * 2 * 2);
+}
+
+static void test_light_traffic_never_drops(void)
+{
+    SimConfig c = make_config(4, 5, 10, 6, 1, 2, 300);
+    SimStats s;
+
+    CHECK(sim_run(&c, &s, NULL, NULL) == 1);
+    CHECK(s.dropped == 0);
+    CHECK(s.passed > 0);
+    CHECK(stats_is_conserved(&s));
+}
+
+static void test_heavy_traffic_drops_but_stays_consistent(void)
+{
+    SimConfig c = make_config(4, QUEUE_CAPACITY, 1, 1, 1, 1, 400);
+    SimStats s;
+
+    CHECK(sim_run(&c, &s, NULL, NULL) == 1);
+    CHECK(s.dropped > 0);
+    CHECK(s.max_queue_length == QUEUE_CAPACITY);
+    CHECK(stats_is_conserved(&s));
+}
+
+/* ---- robustness and repeatability ---- */
+
+static void test_invalid_arguments_are_rejected(void)
+{
+    SimConfig c = make_config(4, 10, 5, 5, 1, 1, 60);
+    SimStats s;
+
+    CHECK(sim_run(NULL, &s, NULL, NULL) == 0);
+    CHECK(sim_run(&c, NULL, NULL, NULL) == 0);
+
+    c.num_directions = 1;
+    CHECK(sim_run(&c, &s, NULL, NULL) == 0);
+    c = make_config(4, QUEUE_CAPACITY + 1, 5, 5, 1, 1, 60);
+    CHECK(sim_run(&c, &s, NULL, NULL) == 0);
+    c = make_config(4, 10, 5, 0, 1, 1, 60);
+    CHECK(sim_run(&c, &s, NULL, NULL) == 0);
+    c = make_config(4, 10, 5, 5, 1, 1, 0);
+    CHECK(sim_run(&c, &s, NULL, NULL) == 0);
+}
+
+static void test_runs_are_repeatable(void)
+{
+    SimConfig c;
+    SimStats a, b;
+    int i;
+
+    sim_config_default(&c);
+    CHECK(sim_run(&c, &a, NULL, NULL) == 1);
+    for (i = 0; i < 20; i++) {
+        CHECK(sim_run(&c, &b, NULL, NULL) == 1);
+        CHECK(memcmp(&a, &b, sizeof a) == 0);       /* identical results every time */
+    }
+}
+
+static void test_default_run_report_is_consistent(void)
+{
+    SimConfig c;
+    SimStats s;
+    char text[512];
+
+    sim_config_default(&c);
+    CHECK(sim_run(&c, &s, NULL, NULL) == 1);
+    CHECK(report_format(text, sizeof text, &s) > 0);
+    CHECK(strstr(text, "Integrity check       : OK") != NULL);
+    CHECK(strstr(text, "Average wait (ticks)") != NULL);
+    CHECK(strstr(text, "Maximum queue length") != NULL);
+}
+
+int main(void)
+{
+    printf("test_simulation\n");
+    TEST_RUN(test_default_config_is_valid);
+    TEST_RUN(test_config_boundaries);
+    TEST_RUN(test_config_validate_edge_cases);
+    TEST_RUN(test_signal_sequence_for_two_directions);
+    TEST_RUN(test_one_direction_active_at_a_time_and_all_served);
+    TEST_RUN(test_signal_invalid_arguments_are_red);
+    TEST_RUN(test_hand_computed_initial_vehicles_only);
+    TEST_RUN(test_hand_computed_with_ongoing_arrivals);
+    TEST_RUN(test_hand_computed_multiple_departures_per_green_tick);
+    TEST_RUN(test_hand_computed_overflow_drops_and_counts);
+    TEST_RUN(test_only_green_direction_moves_and_others_are_unchanged);
+    TEST_RUN(test_report_matches_what_was_observed);
+    TEST_RUN(test_conservation_across_parameter_sweep);
+    TEST_RUN(test_light_traffic_never_drops);
+    TEST_RUN(test_heavy_traffic_drops_but_stays_consistent);
+    TEST_RUN(test_invalid_arguments_are_rejected);
+    TEST_RUN(test_runs_are_repeatable);
+    TEST_RUN(test_default_run_report_is_consistent);
+    return TEST_SUMMARY();
+}
diff --git a/tests/test_stats.c b/tests/test_stats.c
new file mode 100644
index 0000000..15f4557
--- /dev/null
+++ b/tests/test_stats.c
@@ -0,0 +1,188 @@
+/*
+ * S1TMS-9: statistics and end-of-run report.
+ * Hand-computed averages, peak tracking, the conservation check and the
+ * report text.
+ */
+#include <stdio.h>
+#include <string.h>
+
+#include "stats.h"
+#include "test_util.h"
+
+static int near(double a, double b)
+{
+    double d = a - b;
+
+    return d > -1e-9 && d < 1e-9;
+}
+
+static void test_init_zeroes_everything(void)
+{
+    SimStats s;
+
+    memset(&s, 0xAB, sizeof s);
+    stats_init(&s);
+    CHECK(s.generated == 0 && s.passed == 0 && s.dropped == 0);
+    CHECK(s.remaining == 0 && s.total_wait == 0);
+    CHECK(s.max_queue_length == 0 && s.ticks == 0);
+    stats_init(NULL);                               /* must not crash */
+}
+
+static void test_average_wait_hand_computed(void)
+{
+    SimStats s;
+
+    stats_init(&s);
+    stats_record_departure(&s, 2);
+    stats_record_departure(&s, 4);
+    stats_record_departure(&s, 6);                  /* (2 + 4 + 6) / 3 = 4.0 */
+    CHECK(s.passed == 3);
+    CHECK(s.total_wait == 12);
+    CHECK(near(stats_average_wait(&s), 4.0));
+
+    stats_record_departure(&s, 0);                  /* (12 + 0) / 4 = 3.0 */
+    CHECK(near(stats_average_wait(&s), 3.0));
+}
+
+static void test_average_wait_without_departures_is_zero(void)
+{
+    SimStats s;
+
+    stats_init(&s);
+    CHECK(near(stats_average_wait(&s), 0.0));       /* no division by zero */
+    CHECK(near(stats_average_wait(NULL), 0.0));
+}
+
+static void test_max_queue_length_keeps_only_the_peak(void)
+{
+    SimStats s;
+
+    stats_init(&s);
+    stats_record_queue_length(&s, 3);
+    stats_record_queue_length(&s, 7);
+    stats_record_queue_length(&s, 2);
+    stats_record_queue_length(&s, 7);
+    CHECK(s.max_queue_length == 7);
+    stats_record_queue_length(&s, 8);
+    CHECK(s.max_queue_length == 8);
+    stats_record_queue_length(NULL, 99);            /* must not crash */
+}
+
+static void test_conservation_check(void)
+{
+    SimStats s;
+
+    stats_init(&s);
+    s.generated = 10;
+    s.passed = 6;
+    s.dropped = 1;
+    s.remaining = 3;
+    CHECK(stats_is_conserved(&s) == 1);
+
+    s.remaining = 4;                                /* a vehicle appeared from nowhere */
+    CHECK(stats_is_conserved(&s) == 0);
+    s.remaining = 2;                                /* a vehicle was lost */
+    CHECK(stats_is_conserved(&s) == 0);
+    CHECK(stats_is_conserved(NULL) == 0);
+}
+
+static void test_record_generated_counts(void)
+{
+    SimStats s;
+    int i;
+
+    stats_init(&s);
+    for (i = 0; i < 25; i++) {
+        stats_record_generated(&s);
+    }
+    CHECK(s.generated == 25);
+    stats_record_generated(NULL);
+}
+
+static void test_report_contents(void)
+{
+    SimStats s;
+    char text[1024];
+    int needed;
+
+    stats_init(&s);
+    s.ticks = 10;
+    s.generated = 5;
+    s.dropped = 1;
+    s.remaining = 2;
+    stats_record_departure(&s, 3);
+    stats_record_departure(&s, 5);                  /* average wait 4.00 */
+    stats_record_queue_length(&s, 6);
+
+    needed = report_format(text, sizeof text, &s);
+    CHECK(needed > 0 && needed < (int)sizeof text);
+    CHECK(strstr(text, "Ticks simulated       : 10") != NULL);
+    CHECK(strstr(text, "Vehicles generated    : 5") != NULL);
+    CHECK(strstr(text, "Vehicles processed    : 2") != NULL);
+    CHECK(strstr(text, "Vehicles dropped      : 1") != NULL);
+    CHECK(strstr(text, "Vehicles still queued : 2") != NULL);
+    CHECK(strstr(text, "Average wait (ticks)  : 4.00") != NULL);
+    CHECK(strstr(text, "Maximum queue length  : 6") != NULL);
+    CHECK(strstr(text, "Integrity check       : OK") != NULL);
+
+    s.remaining = 3;                                /* break the invariant */
+    CHECK(report_format(text, sizeof text, &s) > 0);
+    CHECK(strstr(text, "Integrity check       : FAILED") != NULL);
+}
+
+static void test_report_format_is_buffer_safe(void)
+{
+    SimStats s;
+    char small[16];
+    char guard[8];
+    int needed;
+
+    stats_init(&s);
+    memset(guard, 'G', sizeof guard);
+
+    needed = report_format(small, sizeof small, &s);
+    CHECK(needed > (int)sizeof small);              /* reports the full length needed */
+    CHECK(strlen(small) < sizeof small);            /* truncated but terminated */
+    CHECK(report_format(NULL, 0, &s) == needed);    /* size query */
+    CHECK(report_format(NULL, 5, &s) == -1);        /* NULL buffer with a size */
+    CHECK(report_format(small, sizeof small, NULL) == -1);
+    CHECK(guard[0] == 'G' && guard[7] == 'G');
+}
+
+static void test_report_print_writes_text(void)
+{
+    SimStats s;
+    char line[128];
+    FILE *f;
+
+    stats_init(&s);
+    s.ticks = 4;
+    f = fopen("tms_test_report.tmp", "w+b");
+    CHECK(f != NULL);
+    if (f == NULL) {
+        return;
+    }
+    report_print(f, &s);
+    report_print(NULL, &s);                         /* must not crash */
+    report_print(f, NULL);
+    rewind(f);
+    CHECK(fgets(line, sizeof line, f) != NULL);
+    CHECK(strstr(line, "SIMULATION SUMMARY") != NULL);
+    fclose(f);
+    remove("tms_test_report.tmp");
+}
+
+int main(void)
+{
+    printf("test_stats\n");
+    TEST_RUN(test_init_zeroes_everything);
+    TEST_RUN(test_average_wait_hand_computed);
+    TEST_RUN(test_average_wait_without_departures_is_zero);
+    TEST_RUN(test_max_queue_length_keeps_only_the_peak);
+    TEST_RUN(test_conservation_check);
+    TEST_RUN(test_record_generated_counts);
+    TEST_RUN(test_report_contents);
+    TEST_RUN(test_report_format_is_buffer_safe);
+    TEST_RUN(test_report_print_writes_text);
+    return TEST_SUMMARY();
+}
-- 
